check: v1[1]*d[1] + v1[0]*d[0] - v_gen*c == 0
  c <- f[3]*h1[3] + f[2]*h1[2] + f[1]*h1[1] + f[0]*h1[0]
  d[0] <- f[1]*h2[1] + f[0]*h2[0]
  d[1] <- f[3]*h2[1] + f[2]*h2[0]
  lhs: - f[3]*h1[3]*v_gen - f[2]*h1[2]*v_gen - f[1]*h1[1]*v_gen - f[0]*h1[0]*v_gen + f[3]*h2[1]*v1[1] + f[2]*h2[0]*v1[1] + f[1]*h2[1]*v1[0] + f[0]*h2[0]*v1[0]
  rhs: 0
  equal modulo the basis, using:
    - h1[3]*v_gen + h2[1]*v1[1]
    - h1[2]*v_gen + h2[0]*v1[1]
    - h1[1]*v_gen + h2[1]*v1[0]
    - h1[0]*v_gen + h2[0]*v1[0]
check: x0[0]*d[1] - x0[0]*d[0] + d[0] == h2[1]*t2[1] + h2[0]*t2[0]
  d[0] <- f[1]*h2[1] + f[0]*h2[0]
  d[1] <- f[3]*h2[1] + f[2]*h2[0]
  t2[0] <- f[2]*x0[0] - f[0]*x0[0] + f[0]
  t2[1] <- f[3]*x0[0] - f[1]*x0[0] + f[1]
  both sides: f[3]*h2[1]*x0[0] - f[1]*h2[1]*x0[0] + f[2]*h2[0]*x0[0] - f[0]*h2[0]*x0[0] + f[1]*h2[1] + f[0]*h2[0]
check: y0[0]*t2[1] - y0[0]*t2[0] + t2[0] == z0
  t2[0] <- f[2]*x0[0] - f[0]*x0[0] + f[0]
  t2[1] <- f[3]*x0[0] - f[1]*x0[0] + f[1]
  z0 == f[3]*x0[0]*y0[0] - f[2]*x0[0]*y0[0] - f[1]*x0[0]*y0[0] + f[0]*x0[0]*y0[0] + f[1]*y0[0] - f[0]*y0[0] + f[2]*x0[0] - f[0]*x0[0] + f[0]
  both sides: f[3]*x0[0]*y0[0] - f[2]*x0[0]*y0[0] - f[1]*x0[0]*y0[0] + f[0]*x0[0]*y0[0] + f[1]*y0[0] - f[0]*y0[0] + f[2]*x0[0] - f[0]*x0[0] + f[0]
