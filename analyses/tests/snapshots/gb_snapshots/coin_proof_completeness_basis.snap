check: f*z_r_y + h2*z_x2 + h1*z_x1 == big_y*ch + t_big_y
  t_big_y <- f*k_r_y + h2*k_x2 + h1*k_x1
  z_x1 <- x1*ch + k_x1
  z_x2 <- x2*ch + k_x2
  z_r_y <- r_y*ch + k_r_y
  big_y == h2*x2 + h1*x1 + f*r_y
  both sides: h2*x2*ch + h1*x1*ch + f*r_y*ch + f*k_r_y + h2*k_x2 + h1*k_x1
check: g*z_alpha + g*z_x1 == big_s*ch + t_big_s
  t_big_s <- g*k_alpha + g*k_x1
  z_x1 <- x1*ch + k_x1
  z_alpha <- alpha*ch + k_alpha
  big_s == g*x1 + alpha*g
  both sides: g*x1*ch + alpha*g*ch + g*k_alpha + g*k_x1
check: g*z_r_beta + g*z_sk_u + g*z_x2 == big_t*ch + t_big_t
  t_big_t <- g*k_r_beta + g*k_sk_u + g*k_x2
  z_x2 <- x2*ch + k_x2
  z_sk_u <- sk_u*ch + k_sk_u
  z_r_beta <- r_beta*ch + k_r_beta
  big_t == g*x2 + g*sk_u + g*r_beta
  both sides: g*x2*ch + g*sk_u*ch + g*r_beta*ch + g*k_r_beta + g*k_sk_u + g*k_x2
check: h*z_r_b + g*z_sk_u == big_b*ch + t_big_b
  t_big_b <- h*k_r_b + g*k_sk_u
  z_sk_u <- sk_u*ch + k_sk_u
  z_r_b <- r_b*ch + k_r_b
  big_b == g*sk_u + h*r_b
  both sides: g*sk_u*ch + h*r_b*ch + h*k_r_b + g*k_sk_u
check: h*z_r_c + g*z_s == big_c*ch + t_big_c
  t_big_c <- h*k_r_c + g*k_s
  z_s <- s*ch + k_s
  z_r_c <- r_c*ch + k_r_c
  big_c == g*s + h*r_c
  both sides: g*s*ch + h*r_c*ch + h*k_r_c + g*k_s
check: h*z_r_c_alpha + g*ch + t_g1 == g*j*z_alpha + big_c*z_alpha + t_h1
  t_g1 <- g*j*k_alpha + big_c*k_alpha
  t_h1 <- h*k_r_c_alpha
  z_alpha <- alpha*ch + k_alpha
  z_r_c_alpha <- r_c_alpha*ch + k_r_c_alpha
  big_c == g*s + h*r_c
  lhs: h*r_c_alpha*ch + g*ch + h*k_r_c_alpha + g*s*k_alpha + h*r_c*k_alpha + g*j*k_alpha
  rhs: alpha*g*s*ch + alpha*h*r_c*ch + alpha*g*j*ch + h*k_r_c_alpha + g*s*k_alpha + h*r_c*k_alpha + g*j*k_alpha
  equal modulo the basis, using:
    alpha*g*s - h*r_c_alpha + alpha*h*r_c + alpha*g*j - g
check: h*z_r_d + g*z_t == big_d*ch + t_big_d
  t_big_d <- h*k_r_d + g*k_t
  z_t <- t*ch + k_t
  z_r_d <- r_d*ch + k_r_d
  big_d == g*t + h*r_d
  both sides: g*t*ch + h*r_d*ch + h*k_r_d + g*k_t
check: h*z_r_d_beta + g*ch + t_g2 == g*j*z_beta + big_d*z_beta + t_h2
  t_g2 <- g*j*k_beta + big_d*k_beta
  t_h2 <- h*k_r_d_beta
  z_beta <- beta*ch + k_beta
  z_r_d_beta <- r_d_beta*ch + k_r_d_beta
  big_d == g*t + h*r_d
  lhs: h*r_d_beta*ch + g*ch + h*k_r_d_beta + g*t*k_beta + h*r_d*k_beta + g*j*k_beta
  rhs: beta*g*t*ch + beta*h*r_d*ch + beta*g*j*ch + h*k_r_d_beta + g*t*k_beta + h*r_d*k_beta + g*j*k_beta
  equal modulo the basis, using:
    beta*g*t - h*r_d_beta + beta*h*r_d + beta*g*j - g
basis:
- alpha*beta*g*t + alpha*beta*g*s + alpha*h*r_d_beta - alpha*beta*h*r_d - beta*h*r_c_alpha + alpha*beta*h*r_c - beta*g + alpha*g
