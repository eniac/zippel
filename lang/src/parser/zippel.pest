WHITESPACE = _{ " " | "\n" | "\r" | "\t" }
line_comment = { "//" ~ (!NEWLINE ~ ANY)* }
block_comment = { "/*" ~ ( !"*/" ~ ANY )* ~ "*/" }
COMMENT = _{ line_comment | block_comment }

/// Terminals
positive = @{ ASCII_DIGIT+ }
one = @{ "1" }
two = @{ "2" }
add_op = @{ "+" }
sub_op = @{ "-" }
mul_op = @{ "*" }
div_op = @{ "/" }
pow_op = @{ "^" }
rem_op = @{ "%" }
concat_op = @{ "++" }
eq_op = @{ "==" }
unary_minus = @{ "-" }

/// Identifiers for functions, variables, type variables
keyword = {"let" | "fn" | "proto" | "type" }
id = @{ !(keyword ~ !(ASCII_ALPHANUMERIC | "_" | "'")) ~ (ASCII_ALPHANUMERIC | "_" | "'" )+ }
ids = _{ id ~ ("," ~ id)* }

/// Ranges appear in types and expressions
range = { step_r | unit_r }
    step_r = { size_ty ~ "," ~ size_ty ~ ".." ~ size_ty }
    unit_r = { size_ty ~ ".." ~ size_ty }

/// Type-level size arithmetic
size_ty  = { size_ty_term ~ (size_bin_op ~ size_ty_term)* }
    size_bin_op   = _{ add_op | sub_op | mul_op | div_op | pow_op }
    size_var      = { id }
    size_ty_term  = _{ "(" ~ size_ty ~ ")" | positive | size_var }

/// Base kinds
kind_ty = { field_ty | group_ty | range_ty | pairing_ty | scalar_ty | size_var_ty | size_ref_ty | positive }
    field_ty    = { "Field" }
    group_ty    = { "Group" }
    pairing_ty  = { "Pairing" ~ "<" ~ id ~ "," ~ id ~ ">" }
    scalar_ty   = { "Scalar" ~ "<" ~ ids ~ ">" }
    range_ty    = { range }
    size_var_ty = { "Size" }
    size_ref_ty = { size_ty }

typ = _{ poly_ty | uni_ty | mle_ty | vec_ty | fin_ty | unit_ty | base_ty | record_ty }
    base_ty = { id }                                              // Base type variable
    poly_ty = { "Poly" ~ "<" ~ id ~ "," ~ size_ty ~ "," ~ size_ty ~ ">" }  // Polynomial type (M vars, degree N)
    uni_ty  = { "Uni" ~ "<" ~ id ~ "," ~ size_ty ~ ">" }          // Univariate polynomial
    mle_ty  = { "Mle" ~ "<" ~ id ~ "," ~ size_ty ~ ">" }          // Multilinear expression
    fin_ty  = { "Fin" ~ "<" ~ (range | size_ty) ~ ">"  }          // Index type
    vec_ty  = { "[" ~ typ ~ ";" ~ size_ty ~ "]" }                 // Vector type
    unit_ty = { "Unit" }                                          // Unit type (assert/verify/protocol return)
    record_ty = { "{" ~ record_field ~ ("," ~ record_field)* ~ "}" }  // Record type
    record_field = { id ~ ":" ~ typ }                            // Record field definition

/// Arithmetic expression language of Zippel
// Top-level expression: allows `;` sequencing via seq_exp
exp         = { let_exp | log_exp | seq_exp | exp_no_seq }
seq_exp     = { exp_no_seq ~ ";" ~ exp? }                             // Universal sequencing: any expr ; cont (trailing ; → Unit)

// Expression without `;` sequencing: binop chain only, used in value positions
exp_no_seq  = { exp_term ~ (record_set_op | proj_op | bin_op ~ exp_term)* }
    record_set_op = { "." ~ "set" ~ "(" ~ id ~ "," ~ exp_no_seq ~ ")" }
exp_term  = _{
         range_exp
         | unit_exp
         | "(" ~ exp ~ ")"
         | fun_exp
         | interpolate_exp
         | mle_exp
         | poly_exp
         | eval_exp
         | dot_exp
         | coef_exp
         | challenge_exp
         | random_exp
         | map_exp
         | reduce_exp
         | vec_exp
         | ram_exp
         | pair_exp
         | assert_exp
         | verify_exp
         | app_exp
         | minus_exp
         | record_exp
         | positive
         | id
    }
    unit_exp      = { "()" }                                           // Unit value
    proj_op   = { "." ~ id }
    fun_exp       = { "fun" ~ ids ~ "=>" ~ exp }                      // Polynomial function definition (body allows seq)
    interpolate_exp = { "interpolate" ~ "(" ~ exp_no_seq ~ ("," ~ exp_no_seq)? ~ ")" }// Unary: FFT grid (inverse FFT); binary: explicit points + evals
    poly_exp      = { "poly" ~ "(" ~ exp_no_seq ~ ")" }                      // Polynomial from coefficients
    eval_exp      = { "eval" ~ eval_selector? ~ "(" ~ exp_no_seq ~ ("," ~ exp_no_seq)? ~ ")" } // Unary: evaluate on FFT grid (FFT); binary: evaluate at explicit points; selected: keep a free variable range
    eval_selector = { "<" ~ (range | size_ty) ~ ">" }                   // eval<i> sugar or eval<i..j> free-variable range
    dot_exp       = { "dot" ~ "(" ~ exp_no_seq ~ "," ~ exp_no_seq ~ ")" }            // Dot product (use dot(a,b) instead of a . b)
    coef_exp      = { "coef" ~ "(" ~ exp_no_seq ~ ")"}                       // Given a polynomial return vector of coefficients of polynomial
    mle_exp       = { "mle" ~ "(" ~ exp_no_seq ~ ")" }                       // Multilinear extension from evaluations over bool hypercube
    random_exp    = { "random" ~ "<" ~ id ~ star? ~ ">" }             // Uniform random sampling (Prover)
    challenge_exp = { "challenge" ~ "<" ~ id ~ star? ~ ">" }          // Random oracle challenge (Verifier)
    map_exp       = { "[" ~ exp ~ "for" ~ id ~ "in" ~ exp_no_seq ~ "]" }     // Map comprehension (body allows seq)
    reduce_exp    = { "reduce" ~ "(" ~ bin_op ~ "," ~ exp_no_seq ~ ")" }     // Reduce operation (left)
    vec_exp       = { "[" ~ exp_no_seq ~ ("," ~ exp_no_seq)* ~ "]" }                // vector of elements
    ram_exp       = { id ~ "[" ~ exp_no_seq ~ "]" }                          // Random access into a vector
    pair_exp      = { "pair" ~ "(" ~ exp_no_seq ~ "," ~ exp_no_seq ~")" }           // Bilinear pairing operation
    range_exp     = { range }                                         // Range expression
    assert_exp    = { "assert" ~ "(" ~ constraint ~ ")" }             // Assertion (Prover) expression
    verify_exp    = { "verify" ~ "(" ~ constraint ~ ")" }             // Assertion (Verifier) expression
    constraint    = { exp_no_seq ~ eq_op ~ exp_no_seq }               // Equality constraint (only inside assert/verify/where)
    app_exp       = { id ~ "(" ~ exps ~ ")" }                         // Function application
    let_exp       = { "let" ~ id ~ (":" ~ typ)? ~ "=" ~ exp_no_seq ~ ";" ~ exp? }  // Let expression (optional type annotation; trailing ; → Unit)
    log_exp       = { id ~ "<-" ~ exp_no_seq ~ ";" ~ exp? }                   // Transcript log expression (trailing ; → Unit)
    minus_exp     = _{ unary_minus ~ exp_no_seq }                            // Negative expressions
    record_exp    = { "{|" ~ record_field_exp ~ ("," ~ record_field_exp)* ~ "|}" }  // Record construction
    record_field_exp = { id ~ ":" ~ exp_no_seq }                             // Record field with value
    bin_op        = _{ concat_op | add_op | sub_op | mul_op | div_op | pow_op | rem_op }
exps = { exp_no_seq ~ ("," ~ exp_no_seq)* }

/// Type variable declarations
tvar  = { id ~ ":" ~ kind_ty }
tvars = { tvar ~ ("," ~ tvar)* }

/// A scalar must be non-zero
star = { "*" }

/// Function and protocol arguments
arg = { qualifier? ~ distribution? ~ id ~ ":" ~ typ }
   qualifier = { public | private }
   public = { "public" }
   private = { "private" }
   distribution = { "uniform" ~ star? }
args = { arg? ~ ("," ~ arg)* }

/// Declarations are either [protocols], [functions], or [type aliases].
decl = { proto_decl | func_decl | type_decl }
    proto_decl = { "proto" ~ id ~ "<" ~ tvars ~ ">" ~ "(" ~ args ~ ")" ~ "where" ~ where_exp ~ "{" ~ exp ~ "}" }
    // where clause: a single expression with == support (via where_eq)
    where_exp = { where_let | where_eq | exp_no_seq }
    where_let = { "let" ~ id ~ (":" ~ typ)? ~ "=" ~ exp_no_seq ~ ";" ~ where_exp? }
    where_eq = { exp_no_seq ~ eq_op ~ exp_no_seq ~ (";" ~ where_exp?)? }
    func_decl  = { "fn" ~ id ~ "<" ~ tvars ~ ">" ~ "(" ~ args ~ ")" ~ ("->" ~ typ)? ~ "{" ~ exp ~ "}" }
    type_decl  = { "type" ~ id ~ "=" ~ typ ~ ";" }

/// Top-level module
decls = { SOI ~ decl* ~ EOI }
