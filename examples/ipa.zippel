// This function implements the recursive Inner Product Argument (Protocol 2 from your text,
// which corresponds to Protocol 1 in the Bulletproofs paper images).
// N_current: Current dimension of vectors g, h, a, b.
// u_base_for_ipa: The 'u' base to be used for L,R commitments and base case check in this IPA run.
fn ipa_recursive<G: Group, F: Scalar<G>>(
    public g_vec_k: [G; 1],          // Current g bases for this round
    public h_vec_k: [G; 1],          // Current h bases for this round
    public u_base_for_ipa: G,                // The 'u' to use for this IPA instance's L,R, and base check
    public P_commitment_k: G,                // Current P commitment for this round
    private a_vec_k_private: [F; 1],  // Prover's current 'a' vector (private)
    private b_vec_k_private: [F; 1]   // Prover's current 'b' vector (private)
) -> Bool {
        // BASE CASE (n=1)
        // Prover "sends" a and b scalars. In non-interactive, these are the final results
        // of the prover's computation, used for the verifier's final check.
        let final_a_scalar = a_vec_k_private[0];
        let final_b_scalar = b_vec_k_private[0];

        // For a fully non-interactive system where this fn contributes to a larger transcript:
        // af_val_base_case <- final_a_scalar;
        // bf_val_base_case <- final_b_scalar;
        // Since this function itself must return true/false for its own validity,
        // it performs the check internally.

        // Verifier computes c = a*b (the inner product for this base case)
        let ip_val_at_base = final_a_scalar * final_b_scalar;

        // Verifier checks if P_commitment_k == g_vec_k[0]*final_a_scalar + h_vec_k[0]*final_b_scalar + u_base_for_ipa*ip_val_at_base
        // (Translated from multiplicative g^a h^b u^c)
        let expected_P_at_base = g_vec_k[0] * final_a_scalar
                               + h_vec_k[0] * final_b_scalar
                               + u_base_for_ipa * ip_val_at_base;

        P_commitment_k == expected_P_at_base
}

fn ipa_recursive<G: Group, F: Scalar<G>, N_current: 1..4>(
    public g_vec_k: [G; 2^N_current],          // Current g bases for this round
    public h_vec_k: [G; 2^N_current],          // Current h bases for this round
    public u_base_for_ipa: G,                  // The 'u' to use for this IPA instance's L,R, and base check
    public P_commitment_k: G,                   // Current P commitment for this round
    private a_vec_k_private: [F; 2^N_current],  // Prover's current 'a' vector (private)
    private b_vec_k_private: [F; 2^N_current]   // Prover's current 'b' vector (private)
) -> Bool {
        // RECURSIVE STEP (n > 1)

        // Prover computes c_L, c_R and then L, R.
        // Slice prover's private vectors a and b
        let a_p_lo = a_vec_k_private[0..2^(N_current-1)];
        let a_p_hi = a_vec_k_private[2^(N_current-1)..2^N_current];
        let b_p_lo = b_vec_k_private[0..2^(N_current-1)];
        let b_p_hi = b_vec_k_private[2^(N_current-1)..2^N_current];

        // Slice current g and h base vectors (these are public for this round)
        let g_v_lo = g_vec_k[0..2^(N_current-1)];
        let g_v_hi = g_vec_k[2^(N_current-1)..2^N_current];
        let h_v_lo = h_vec_k[0..2^(N_current-1)];
        let h_v_hi = h_vec_k[2^(N_current-1) .. 2^N_current];

        let cL_val = a_p_lo . b_p_hi; // Dot product <a_lo, b_hi>
        let cR_val = a_p_hi . b_p_lo; // Dot product <a_hi, b_lo>

        // Prover "sends" L and R by adding them to the transcript.
        // L = (g_hi^a_lo) * (h_lo^b_hi) * (u^c_L)  (multiplicative notation)
        // L = g_hi*a_lo) + reduce(+, h_lo*b_hi) + u_base_for_ipa*c_L (additive)
        L_transcript <- g_v_hi . a_p_lo + h_v_lo . b_p_hi + u_base_for_ipa * cL_val;
        R_transcript <- g_v_lo . a_p_hi + h_v_hi . b_p_lo + u_base_for_ipa * cR_val;

        // Verifier "sends" challenge x (derived from transcript using Fiat-Shamir)
        x_challenge <- challenge<F>;

        // Both Prover and Verifier compute parameters for the next recursive call:
        // g' = g_lo^(x^-1) * g_hi^x  (multiplicative)
        // g_prime = g_lo * (1/x_challenge) + g_hi * x_challenge (additive)
        let g_prime_next = g_v_lo / x_challenge + g_v_hi * x_challenge;
        let h_prime_next = h_v_lo * x_challenge + h_v_hi * (1/x_challenge);

        // P' = L^(x^2) * P * R^(x^-2) (multiplicative)
        // P_prime = L_transcript * (x_challenge*x_challenge) + P_commitment_k + R_transcript * ((1/x_challenge)*(1/x_challenge)) (additive)
        let P_prime_next = L_transcript * (x_challenge*x_challenge)
                         + P_commitment_k
                         + R_transcript * ((1/x_challenge)*(1/x_challenge));

        // Prover computes a' and b' for its private input to the next recursive call
        let a_prime_private = a_p_lo * x_challenge + a_p_hi * (1/x_challenge);
        let b_prime_private = b_p_lo * (1/x_challenge) + b_p_hi * x_challenge;

        // Recursively call protocol_2_ipa_recursive for the next smaller problem instance.
        // The N_current for the recursive call is (N_current / 2).
        // The u_base_for_ipa remains the same throughout this IPA instance.
        ipa_recursive(
            g_prime_next,
            h_prime_next,
            u_base_for_ipa, // Pass the same u received by this function call
            P_prime_next,
            a_prime_private,
            b_prime_private
        )
}


proto ipa_wrapper<G: Group, F: Scalar<G>, N_val_const: 2>(
    // --- Public Inputs ---
    public g_vec: [G; N_val_const],    // Corresponds to 'g' in the paper (vector of group elements)
    public h_vec: [G; N_val_const],    // Corresponds to 'h' in the paper (vector of group elements)
    public P_initial_commitment: G,   // Corresponds to 'P' in the paper
    public ip_val_claimed: F,         // Corresponds to 'c' (the inner product value) in the paper
    public u_aux_base: G,             // Corresponds to 'u' in the paper

    // --- Private Inputs ---
    private a_vec_witness: [F; N_val_const],   // Corresponds to 'a' in the paper (vector of field elements)
    private b_vec_witness: [F; N_val_const]    // Corresponds to 'b' in the paper (vector of field elements)
) where
        (P_initial_commitment == ((g_vec . a_vec_witness)
        + (h_vec . b_vec_witness)
        + u_aux_base * ip_val_claimed)) && (ip_val_claimed == (a_vec_witness . b_vec_witness)) {
    // 1. "Verifier generates x <-$ Z*_p and sends it to Prover."
    //    In our non-interactive DSL, this is a Fiat-Shamir challenge.
    //    The challenge 'x_chal' is a scalar of type F.
    x_chal <- challenge<F>;

    // 2. "Let P' = P * u^(x*c)"
    //    Translating to additive notation: P_prime = P_initial_commitment + u_aux_base * (x_chal * ip_val_claimed)
    //    'x_chal * ip_val_claimed' is a scalar multiplication.
    //    'u_aux_base * (scalar)' is scalar multiplication of a group element.
    let P_prime = P_initial_commitment + u_aux_base * (x_chal * ip_val_claimed);

    //    We also need u^x for the input to Protocol 2.
    //    Translating to additive notation: u_raised_to_x = u_aux_base * x_chal
    let u_raised_to_x = u_aux_base * x_chal;

    // 3. "Run Protocol 2 (ipa recursive) on Input(g, h, u^x, P'; a, b)"
    //    We call the assumed 'protocol_2' function.
    //    The inputs g_vec, h_vec are the original public base vectors.
    //    u_raised_to_x and P_prime are the values computed above.
    //    a_vec_witness and b_vec_witness are the original private witness vectors.
    let verification_result = ipa_recursive(
                                            g_vec,
                                            h_vec,
                                            u_raised_to_x,
                                            P_prime,
                                            a_vec_witness,
                                            b_vec_witness
                                        );

    // This Protocol 1 succeeds if the called ipa_recursive verifies successfully.
    verify(verification_result);
}
