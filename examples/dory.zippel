// Protocol 14: Dory Evaluation Proof (Inner Product Argument using Bilinear Pairings)
// This proves knowledge of vectors u in G1^n and g in G2^n such that:
// c1 = <u, g>
// c2 = <u, gamma2>
// c3 = <g, gamma1>
// Where <a, b> represents the inner pairing product (IPP).

// Base Case (n = 1) -> maps to N=0 in power
fn dory_reduce<
    G1: Group,
    G2: Group,
    GT: Pairing<G1, G2>,
    F: Scalar<G1, G2>
>(
    public c1: GT,
    public c2: GT,
    public c3: GT,
    public gamma1: [G1; 1],
    public gamma2: [G2; 1],
    private u_vec: [G1; 1],
    private g_vec: [G2; 1]
) -> Bool {
    // Prover sends u and g
    log_u <- u_vec[0];
    log_g <- g_vec[0];

    // Verifier checks
    let check1 = c1 == pair(u_vec[0], g_vec[0]);
    let check2 = c2 == pair(u_vec[0], gamma2[0]);
    let check3 = c3 == pair(gamma1[0], g_vec[0]);

    check1 && check2 && check3
}

// Intermediate case: N = 1 (size = 2 elements). 
// Here we recurse down to array size = 1 (N=0).
fn dory_reduce<
    G1: Group,
    G2: Group,
    GT: Pairing<G1, G2>,
    F: Scalar<G1, G2>
>(
    public c1: GT,
    public c2: GT,
    public c3: GT,
    public gamma1: [G1; 2],
    public gamma2: [G2; 2],
    public gamma1_prime: [G1; 1],
    public gamma2_prime: [G2; 1],
    public hash_l: GT,
    public hash_r: GT,
    public gamma_pair_ipp: GT,

    // Prover's private state
    private u_vec: [G1; 2],
    private g_vec: [G2; 2]
) -> Bool {
    // 1. Prover computes left/right commitments using the next level's bases
    let u_l = u_vec[0..1];
    let u_r = u_vec[1..2];
    let g_l = g_vec[0..1];
    let g_r = g_vec[1..2];

    let D1_l = reduce(+, [pair(u_l[0], gamma2_prime[0]) for i in 0..1]);
    let D1_r = reduce(+, [pair(u_r[0], gamma2_prime[0]) for i in 0..1]);
    let D2_l = reduce(+, [pair(gamma1_prime[0], g_l[0]) for i in 0..1]);
    let D2_r = reduce(+, [pair(gamma1_prime[0], g_r[0]) for i in 0..1]);

    log_D1l <- D1_l;
    log_D1r <- D1_r;
    log_D2l <- D2_l;
    log_D2r <- D2_r;

    rho <- challenge<F>;
    let rho_inv = 1 / rho;

    let w1 = u_vec + gamma1 * rho;
    let w2 = g_vec + gamma2 * rho_inv;

    let w1_l = w1[0..1];
    let w1_r = w1[1..2];
    let w2_l = w2[0..1];
    let w2_r = w2[1..2];

    let v_l = reduce(+, [pair(w1_l[0], w2_r[0]) for i in 0..1]);
    let v_r = reduce(+, [pair(w1_r[0], w2_l[0]) for i in 0..1]);

    log_vl <- v_l;
    log_vr <- v_r;

    alpha <- challenge<F>;
    let alpha_inv = 1 / alpha;
    let alpha_sq = alpha * alpha;
    let alpha_inv_sq = alpha_inv * alpha_inv;

    let u_prime = w1_l * alpha + w1_r * alpha_inv;
    let g_prime = w2_l * alpha_inv + w2_r * alpha;

    let c1_prime = c1 + rho_inv * c2 + rho * c3 + gamma_pair_ipp + alpha_sq * v_l + alpha_inv_sq * v_r;
    let c2_prime = alpha * D1_l + alpha_inv * D1_r + (alpha * rho) * hash_l + (alpha_inv * rho) * hash_r;
    let c3_prime = alpha_inv * D2_l + alpha * D2_r + (alpha_inv * rho_inv) * hash_l + (alpha * rho_inv) * hash_r;

    dory_reduce(
        c1_prime,
        c2_prime,
        c3_prime,
        gamma1_prime,
        gamma2_prime,
        u_prime,
        g_prime
    )
}

// Recursive Step (n > 2)
fn dory_reduce<
    G1: Group,
    G2: Group,
    GT: Pairing<G1, G2>,
    F: Scalar<G1, G2>,
    N: 2..3
>(
    public c1: GT,
    public c2: GT,
    public c3: GT,
    // The previous recursion level gamma bases
    public gamma1: [G1; 2^N],
    public gamma2: [G2; 2^N],
    // The next level's gamma bases (provided by verifier in preprocessing)
    public gamma1_prime: [G1; 2^(N-1)],
    public gamma2_prime: [G2; 2^(N-1)],
    // The commitments to gamma halves
    public hash_l: GT,
    public hash_r: GT,
    // Preprocessed evaluations
    public gamma_pair_ipp: GT,

    // Prover's private state
    private u_vec: [G1; 2^N],
    private g_vec: [G2; 2^N]
) -> Bool {
    // 1. Prover computes left/right commitments using the next level's bases
    let u_l = u_vec[0..2^(N-1)];
    let u_r = u_vec[2^(N-1)..2^N];
    let g_l = g_vec[0..2^(N-1)];
    let g_r = g_vec[2^(N-1)..2^N];

    let D1_l = reduce(+, [pair(u_l[i], gamma2_prime[i]) for i in 0..2^(N-1)]);
    let D1_r = reduce(+, [pair(u_r[i], gamma2_prime[i]) for i in 0..2^(N-1)]);
    let D2_l = reduce(+, [pair(gamma1_prime[i], g_l[i]) for i in 0..2^(N-1)]);
    let D2_r = reduce(+, [pair(gamma1_prime[i], g_r[i]) for i in 0..2^(N-1)]);

    // Prover sends D terms to the transcript
    log_D1l <- D1_l;
    log_D1r <- D1_r;
    log_D2l <- D2_l;
    log_D2r <- D2_r;

    // 2. Verifier sends rho
    rho <- challenge<F>;
    let rho_inv = 1 / rho;

    // 3. Prover logic
    let w1 = u_vec + gamma1 * rho;
    let w2 = g_vec + gamma2 * rho_inv;

    let w1_l = w1[0..2^(N-1)];
    let w1_r = w1[2^(N-1)..2^N];
    let w2_l = w2[0..2^(N-1)];
    let w2_r = w2[2^(N-1)..2^N];

    // 4. Prover sends v_L and v_R
    let v_l = reduce(+, [pair(w1_l[i], w2_r[i]) for i in 0..2^(N-1)]);
    let v_r = reduce(+, [pair(w1_r[i], w2_l[i]) for i in 0..2^(N-1)]);

    log_vl <- v_l;
    log_vr <- v_r;

    // 5. Verifier checks and sends alpha
    alpha <- challenge<F>;
    let alpha_inv = 1 / alpha;
    let alpha_sq = alpha * alpha;
    let alpha_inv_sq = alpha_inv * alpha_inv;

    // 6. Prover computes new u' and g'
    let u_prime = w1_l * alpha + w1_r * alpha_inv;
    let g_prime = w2_l * alpha_inv + w2_r * alpha;

    // 7. Verifier computes c1', c2', c3'
    let c1_prime = c1 + rho_inv * c2 + rho * c3 + gamma_pair_ipp + alpha_sq * v_l + alpha_inv_sq * v_r;
    let c2_prime = alpha * D1_l + alpha_inv * D1_r + (alpha * rho) * hash_l + (alpha_inv * rho) * hash_r;
    let c3_prime = alpha_inv * D2_l + alpha * D2_r + (alpha_inv * rho_inv) * hash_l + (alpha * rho_inv) * hash_r;

    // 8. Recurse to the next round with n/2 elements
    // Note: The verifier preprocessing logic is recursive up to n/2.
    // In our simplified setup, the caller needs to provide all gamma elements across levels.
    // For this example, we'll extract the next level's gamma primes from the first half of current gamma primes.
    // In a full application, these would be indexed arrays or derived from SRS hashes.
    // Note: N here means the power of 2. So current arrays are 2^N, primes are 2^(N-1).
    // The next level needs 2^(N-2) arrays.
    let next_gamma1_prime = gamma1_prime[0..2^(N-2)];
    let next_gamma2_prime = gamma2_prime[0..2^(N-2)];
    
    // Similarly mock hash_L / hash_R / gamma_pair_ipp for the next level
    let next_hash_l = hash_l;
    let next_hash_r = hash_r;
    let next_gamma_pair_ipp = gamma_pair_ipp;

    dory_reduce(
        c1_prime,
        c2_prime,
        c3_prime,
        gamma1_prime,
        gamma2_prime,
        next_gamma1_prime,
        next_gamma2_prime,
        next_hash_l,
        next_hash_r,
        next_gamma_pair_ipp,
        u_prime,
        g_prime
    )
}

// Wrapper Protocol for Dory
proto dory_eval<
    G1: Group,
    G2: Group,
    GT: Pairing<G1, G2>,
    F: Scalar<G1, G2>,
    N_CONST: 2
>(
    // Inputs (from the top-level N)
    public c1: GT,
    public c2: GT,
    public c3: GT,
    public gamma1: [G1; N_CONST],
    public gamma2: [G2; N_CONST],
    public gamma1_prime: [G1; N_CONST/2],
    public gamma2_prime: [G2; N_CONST/2],
    public hash_l: GT,
    public hash_r: GT,
    public gamma_pair_ipp: GT,

    // Prover's private secrets
    private u_vec: [G1; N_CONST],
    private g_vec: [G2; N_CONST]
) where
    c1 == reduce(+, [pair(u_vec[i], g_vec[i]) for i in 0..N_CONST]) &&
    c2 == reduce(+, [pair(u_vec[i], gamma2[i]) for i in 0..N_CONST]) &&
    c3 == reduce(+, [pair(gamma1[i], g_vec[i]) for i in 0..N_CONST])
{
    // Start the reduction proof
    let verified = dory_reduce(
        c1,
        c2,
        c3,
        gamma1,
        gamma2,
        gamma1_prime,
        gamma2_prime,
        hash_l,
        hash_r,
        gamma_pair_ipp,
        u_vec,
        g_vec
    );
    verify(verified);
}
