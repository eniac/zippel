// This example implements the information-theoretic core of Spartan
// Sizes:
//
//   num_constraints = 4   (m = matrix dimension; s = log num_constraints = 2)
//   |io| = 1, |w| = 2     (so |w| + |io| + 1 = num_constraints; matrices are square)
//   z   = (w_0, w_1, io_0, 1)
//
// How to run:
//   cargo run --example spartan --release
//
// analyze_completeness() and analyze_knowledge() — do NOT
// terminate 
//
// How to change the dimensions. The proto is hard-coded for s = 2
// (num_constraints = 4) with square matrices, so changes touch both this
// file and examples/spartan/main.rs:
//
//   - Re-split (|w|, |io|) at the same num_constraints. Edit IO_LEN and
//     WITNESS_LEN in main.rs (they must sum to num_constraints - 1) and
//     the matching [F; ...] sizes in the proto signature below. Update
//     the v_w / v_io / v_z block near the bottom of this file: it encodes
//     the LSB-first w / (io, 1) selector for the current |w| = 2,
//     |io| = 1 split and must be rewritten for any other split.
//
//   - Bump num_constraints to 2^s with s > 2. In this file: replace
//     every `0..4` loop bound with `0..m`, every `[F; 16]` with
//     `[F; m*m]`, set `num_variables: 2` → s in both marginalize configs,
//     unroll one additional sum-check round in *each* of sum-check #1
//     and sum-check #2 per extra s-step, and extend the Lagrange bases
//     (lx_** and ly_** plus partial_a/b/c) from 4 to 2^s entries. Also
//     bump NUM_CONSTRAINTS in main.rs and re-pick (WITNESS_LEN, IO_LEN)
//     so they sum to num_constraints - 1.

proto spartan<F: Field>(
    public mat_a: [F; 16],
    public mat_b: [F; 16],
    public mat_c: [F; 16],
    public io: [F; 1],
    private w: [F; 2]
) where
    let one = io[0] - io[0] + 1;
    let z = w ++ io ++ [one];
    let az = [reduce(+, [mat_a[i*4 + j] * z[j] for j in 0..4]) for i in 0..4];
    let bz = [reduce(+, [mat_b[i*4 + j] * z[j] for j in 0..4]) for i in 0..4];
    let cz = [reduce(+, [mat_c[i*4 + j] * z[j] for j in 0..4]) for i in 0..4];
    az * bz == cz
{
    let one  = io[0] - io[0] + 1;
    let zero = io[0] - io[0];

    // z = (w_0, w_1, io_0, 1)
    let z = w ++ io ++ [one];

    // (A z), (B z), (C z) over the row-hypercube.
    let az = [reduce(+, [mat_a[i*4 + j] * z[j] for j in 0..4]) for i in 0..4];
    let bz = [reduce(+, [mat_b[i*4 + j] * z[j] for j in 0..4]) for i in 0..4];
    let cz = [reduce(+, [mat_c[i*4 + j] * z[j] for j in 0..4]) for i in 0..4];

    let f_a = mle(az);
    let f_b = mle(bz);
    let f_c = mle(cz);

    // -------- V draws tau in F^s --------
    tau0 <- challenge<F>;
    tau1 <- challenge<F>;

    // ẽq(tau, x) evaluations in LSB-first order (var_0 = idx & 1, var_1 = (idx>>1) & 1).
    let eq_tau_evs = [
        (one - tau0) * (one - tau1),   // idx 0: (var_0=0, var_1=0)
        tau0 * (one - tau1),           // idx 1: (var_0=1, var_1=0)
        (one - tau0) * tau1,           // idx 2: (var_0=0, var_1=1)
        tau0 * tau1                    // idx 3: (var_0=1, var_1=1)
    ];
    let eq_tau = mle(eq_tau_evs);

    // g(x) = ( f_A(x) f_B(x) - f_C(x) ) * ẽq(tau, x). We construct it as
    // f_a*f_b + (-1)*f_c, then multiply by eq_tau, to side-step a direct
    // poly-poly subtraction.
    let neg_one = zero - one;
    let fab     = f_a * f_b;
    let neg_f_c = f_c * neg_one;
    let g_sub   = fab + neg_f_c;
    let g_poly  = g_sub * eq_tau;

    // ======== Sum-check #1 (claimed sum = 0; s = 2 rounds; degree 3) ========

    let cfg1_0 = {| poly: g_poly, num_variables: 2, max_degree: 3, round: 0, challenge: zero |};
    let out1_0 = marginalize(cfg1_0);
    evs1_0 <- out1_0.evaluations;
    verify(zero == evs1_0[0] + evs1_0[1]);

    let pts3 = [i * one for i in 0..4];
    let g1_r1 = interpolate(pts3, evs1_0);
    rx0 <- challenge<F>;
    let prev1_vec = eval(g1_r1, [rx0]);
    let prev1 = prev1_vec[0];

    let cfg1_1 = {| poly: out1_0.next_poly, num_variables: 2, max_degree: 3, round: 1, challenge: rx0 |};
    let out1_1 = marginalize(cfg1_1);
    evs1_1 <- out1_1.evaluations;
    verify(prev1 == evs1_1[0] + evs1_1[1]);

    let g1_r2 = interpolate(pts3, evs1_1);
    rx1 <- challenge<F>;
    let e_x_vec = eval(g1_r2, [rx1]);
    let e_x = e_x_vec[0];   // claim: g_poly(rx0, rx1) == e_x

    // ======== Linking: prover reveals v_A, v_B, v_C ========
    // Lagrange coefficients at the sum-check #1 point (rx0, rx1) in LSB-first
    // labelling: lx_<var_0><var_1> sits at evaluation-vector index var_0 + 2*var_1.
    let omr0  = one - rx0;
    let omr1  = one - rx1;
    let lx_00 = omr0 * omr1;
    let lx_10 = rx0  * omr1;
    let lx_01 = omr0 * rx1;
    let lx_11 = rx0  * rx1;

    v_a <- lx_00 * az[0] + lx_10 * az[1] + lx_01 * az[2] + lx_11 * az[3];
    v_b <- lx_00 * bz[0] + lx_10 * bz[1] + lx_01 * bz[2] + lx_11 * bz[3];
    v_c <- lx_00 * cz[0] + lx_10 * cz[1] + lx_01 * cz[2] + lx_11 * cz[3];

    let eq_tau_at_rx =
        lx_00 * eq_tau_evs[0] + lx_10 * eq_tau_evs[1]
      + lx_01 * eq_tau_evs[2] + lx_11 * eq_tau_evs[3];

    verify(e_x == (v_a * v_b - v_c) * eq_tau_at_rx);

    // ======== V draws r_A, r_B, r_C; T_2 = r_A v_A + r_B v_B + r_C v_C ========
    ra <- challenge<F>;
    rb <- challenge<F>;
    rc <- challenge<F>;
    let t2 = ra * v_a + rb * v_b + rc * v_c;

    // A_partial[j] = Ã(r_x_0, r_x_1, y = col-hypercube index j).
    // Under the row-major LSB-first layout (idx = i*4 + j), the row bits
    // sit in MLE variables 2,3 and the column bits in 0,1, so partially
    // fixing the row variables at r_x amounts to forming the Lagrange
    // combination of the four row blocks.
    let partial_a = [
        lx_00 * mat_a[ 0 + y] + lx_10 * mat_a[ 4 + y]
      + lx_01 * mat_a[ 8 + y] + lx_11 * mat_a[12 + y]
        for y in 0..4
    ];
    let partial_b = [
        lx_00 * mat_b[ 0 + y] + lx_10 * mat_b[ 4 + y]
      + lx_01 * mat_b[ 8 + y] + lx_11 * mat_b[12 + y]
        for y in 0..4
    ];
    let partial_c = [
        lx_00 * mat_c[ 0 + y] + lx_10 * mat_c[ 4 + y]
      + lx_01 * mat_c[ 8 + y] + lx_11 * mat_c[12 + y]
        for y in 0..4
    ];

    // L(y) = r_A A_partial(y) + r_B B_partial(y) + r_C C_partial(y).
    let combined = [
        ra * partial_a[y] + rb * partial_b[y] + rc * partial_c[y]
        for y in 0..4
    ];
    let l_mle = mle(combined);

    // z~ as a 2-variable MLE in the column variables (same LSB-first layout).
    let z_mle = mle(z);

    // M(y) = L(y) * z~(y); Poly<F, 2, 2>.
    let m_poly = l_mle * z_mle;

    // ======== Sum-check #2 (claimed sum = T_2; s = 2 rounds; degree 2) ========

    let cfg2_0 = {| poly: m_poly, num_variables: 2, max_degree: 2, round: 0, challenge: zero |};
    let out2_0 = marginalize(cfg2_0);
    evs2_0 <- out2_0.evaluations;
    verify(t2 == evs2_0[0] + evs2_0[1]);

    let pts2 = [i * one for i in 0..3];
    let g2_r1 = interpolate(pts2, evs2_0);
    ry0 <- challenge<F>;
    let prev2_vec = eval(g2_r1, [ry0]);
    let prev2 = prev2_vec[0];

    let cfg2_1 = {| poly: out2_0.next_poly, num_variables: 2, max_degree: 2, round: 1, challenge: ry0 |};
    let out2_1 = marginalize(cfg2_1);
    evs2_1 <- out2_1.evaluations;
    verify(prev2 == evs2_1[0] + evs2_1[1]);

    let g2_r2 = interpolate(pts2, evs2_1);
    ry1 <- challenge<F>;
    let e_y_vec = eval(g2_r2, [ry1]);
    let e_y = e_y_vec[0];

    // ======== Final verifier check ========
    // Under the chosen z layout, var_1 is the witness/(io, 1) selector and
    // the corresponding sum-check #2 challenge is r_y_1. So:
    //
    //   v_w     = w~(r_y_0)       = (1 - r_y_0) w_0 + r_y_0 w_1
    //   v_io    = (io, 1)~(r_y_0) = (1 - r_y_0) io_0 + r_y_0 * 1
    //   v_Z     = (1 - r_y_1) v_w + r_y_1 v_io
    //
    // The prover commits to v_w (the witness MLE evaluation); the verifier
    // computes v_io directly from the public io.
    let v_w_val = (one - ry0) * w[0] + ry0 * w[1];
    sent_v_w <- v_w_val;
    let v_io = (one - ry0) * io[0] + ry0 * one;
    let v_z  = (one - ry1) * sent_v_w + ry1 * v_io;

    // Verifier evaluates A~, B~, C~ at the full point (r_x, r_y) by direct
    // Lagrange combination over mat_a, mat_b, mat_c (matrices are public).
    let omry0 = one - ry0;
    let omry1 = one - ry1;
    let ly_00 = omry0 * omry1;
    let ly_10 = ry0   * omry1;
    let ly_01 = omry0 * ry1;
    let ly_11 = ry0   * ry1;

    let v1 = ly_00 * partial_a[0] + ly_10 * partial_a[1]
           + ly_01 * partial_a[2] + ly_11 * partial_a[3];
    let v2 = ly_00 * partial_b[0] + ly_10 * partial_b[1]
           + ly_01 * partial_b[2] + ly_11 * partial_b[3];
    let v3 = ly_00 * partial_c[0] + ly_10 * partial_c[1]
           + ly_01 * partial_c[2] + ly_11 * partial_c[3];

    verify(e_y == (ra * v1 + rb * v2 + rc * v3) * v_z)
}
