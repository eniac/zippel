// Schnorr OR proof: prove knowledge of x1 OR x2
// such that y1 = g*x1 OR y2 = g*x2
// (This version assumes the prover knows x1)
proto schnorr_or<G: Group, F: Scalar<G>>(
    private x1: F,
    public g: G,
    public y1: G,
    public y2: G
) where y1 == g*x1 {
    // Prover samples randomness for the honest branch
    let r1 = random<F>;

    // Prover pre-picks simulated challenge and response for branch 2
    let e2 = random<F>;
    let s2 = random<F>;

    // Commitment for honest branch: t1 = g^r1
    t1 <- g*r1;

    // Simulated commitment for branch 2: t2 = g^s2 - y2*e2
    // (equivalent to g^s2 * y2^(-e2), since subtraction in additive notation)
    t2 <- g*s2 - y2*e2;

    // Verifier sends challenge
    e <- challenge<F*>;

    // Prover computes honest challenge: e1 = e - e2
    let e1 = e - e2;

    // Prover computes honest response: s1 = r1 + e1*x1
    let s1 = r1 + e1*x1;

    // Send all sub-challenges and responses
    e1 <- e1;
    s1 <- s1;
    e2 <- e2;
    s2 <- s2;

    // Verifier checks:
    // (i)   e1 + e2 == e
    // (ii)  g*s1 == t1 + y1*e1
    // (iii) g*s2 == t2 + y2*e2
    verify(e1 + e2 == e && g*s1 == t1 + y1*e1 && g*s2 == t2 + y2*e2)
}
