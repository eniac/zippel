// Marlin-KZG, zero-knowledge KZG: PolyCommit_Ped (Kate, Zaverucha, Goldberg 2010, §3.3; Marlin, App. B.2.1).
//
// Plain KZG leaks p(x): its commitment is deterministic. Here the prover also commits to a random
// polynomial r(x) of the same degree, under a second generator gamma * g whose discrete log is
// unknown:
//   commit: c  = [p(tau)]_1 + [gamma r(tau)]_1
//   open z: pi = [q(tau)]_1 + [gamma q_r(tau)]_1, with q = (p - y) / (x - z) and
//           q_r = (r - r(z)) / (x - z), and r(z) is sent in the clear
//   check:  e(pi, tau h - z h) == e(c - y g - r(z) gamma g, h)
//
// The SRS is two parallel vectors of N powers of tau: ss for g, gs for gamma * g.
// The `where` clause specifies the trusted setup directly.

proto marlin_kzg<G1: Group, G2: Group, GT: Pairing<G1, G2>, F: Scalar<G1, G2>, N: Size>(
    witness p_val: Uni<F, N - 1>,
    instance z: F,
    instance y: F,
    extra ss: [G1; N],
    extra gs: [G1; N],
    instance g: G1,
    instance gamma_g: G1,
    instance h: G2,
    instance h_val: G2,
) where
    let tau = random<F>;
    let gamma = random<F>;
    ss == [tau ^ i * g for i in 0..N]
        && gs == [tau ^ i * gamma_g for i in 0..N]
        && gamma_g == gamma * g
        && h_val == tau * h
        && p_val(z) == y
{
    // Blinding polynomial, of the same degree as p.
    let r_val = poly([random<F> for _ in 0..N]);
    c <- dot(coef(p_val), ss) + dot(coef(r_val), gs);

    // The quotients keep their dividends' bounds; dividing by the monic linear X - z leaves
    // N - 1 meaningful coefficients.
    let x_minus_z = poly([-z, 1]);
    let q = (p_val - y) / x_minus_z;
    let r_z = r_val(z);
    let q_r = (r_val - r_z) / x_minus_z;
    let q_coefs = coef(q);
    let q_r_coefs = coef(q_r);
    pi <- dot(q_coefs[0..N - 1], ss[0..N - 1]) + dot(q_r_coefs[0..N - 1], gs[0..N - 1]);
    r_z_sent <- r_z;

    verify(pair(pi, h_val - h * z) == pair(c - y * g - r_z_sent * gamma_g, h))
}
