// Groth16 zkSNARK Protocol (h-coefficients provided externally)
// Reference: Groth, J. (2016). "On the Size of Pairing-Based Non-interactive Arguments."
//
// This variant accepts h_coeffs as a private input, computed externally
// by the Rust R1CS-to-QAP conversion. Compare with groth16.zippel which
// computes h_coeffs inside zippel via FFT-based evaluation-domain arithmetic.
// Random blinding factors r and s are sampled internally via random<F>.
//
// Size parameters (following Groth16 paper):
//   M: number of public inputs (including the constant 1)
//   L: number of private witness variables
//   H: length of h_query and h_coeffs (= domain_size - 1)
//   Total QAP variables = M + L

proto groth16<G1: Group, G2: Group, GT: Pairing<G1, G2>, F: Scalar<G1, G2>, M: Size, L: Size, H: Size>(
    public alpha_g1: G1,
    public beta_g2: G2,
    public gamma_g2: G2,
    public delta_g2: G2,
    public gamma_abc_g1: [G1; M],
    private beta_g1: G1,
    private delta_g1: G1,
    private a_query: [G1; M+L],
    private b_g1_query: [G1; M+L],
    private b_g2_query: [G2; M+L],
    private h_query: [G1; H],
    private l_query: [G1; L],
    public instance_assignment: [F; M],
    private witness_assignment: [F; L],
    private h_coeffs: [F; H],
    // Relation-only trapdoor witnesses (analogous to pst13.zippel's
    // `private alpha`). The proto body and verifier never reference
    // these; they exist so the `where` clause can express the QAP
    // identity at the trusted-setup trapdoor τ:
    //   ⟨A(τ), z⟩ · ⟨B(τ), z⟩ - ⟨C(τ), z⟩ == H(τ) · t(τ),
    // where z = instance ++ witness and A_i(τ), B_i(τ), C_i(τ) are the
    // QAP polynomial evaluations at τ.
    private a_evs: [F; M+L],
    private b_evs: [F; M+L],
    private c_evs: [F; M+L],
    private tau: F,
    private t_at_tau: F
) where
    let full_assign = instance_assignment ++ witness_assignment;
    let a_at_tau = dot(a_evs, full_assign);
    let b_at_tau = dot(b_evs, full_assign);
    let c_at_tau = dot(c_evs, full_assign);
    let h_at_tau = dot(h_coeffs, [tau ^ j for j in 0..H]);
    a_at_tau * b_at_tau - c_at_tau == h_at_tau * t_at_tau
{
    let r = random<F>;
    let s = random<F>;
    let full_assignment = instance_assignment ++ witness_assignment;

    let a_val = alpha_g1 + dot(a_query, full_assignment) + delta_g1 * r;
    a_proof <- a_val;
    b_proof <- beta_g2 + dot(b_g2_query, full_assignment) + delta_g2 * s;

    let b_g1_val = beta_g1 + dot(b_g1_query, full_assignment) + delta_g1 * s;
    let c_h = dot(h_query, h_coeffs);
    let c_l = dot(l_query, witness_assignment);
    c_proof <- c_h + c_l + a_val * s + b_g1_val * r - delta_g1 * (r * s);

    let ic = dot(gamma_abc_g1, instance_assignment);

    // Fold the 4-pair check into a single `multi_miller_loop +
    // final_exponentiation`. The native verifier does this via
    // `Pairing::multi_pairing`; zippel exposes the same fast path
    // through `dot(VecG1, VecG2) -> GT` (backend/src/config.rs:357).
    // Rearrange  e(A,B) == e(α,β) + e(IC,γ) + e(C,δ)
    //         ⟺  e(A,B) + e(-α,β) + e(-IC,γ) + e(-C,δ) == 0_GT.
    // Negate G1 points via binary subtraction (zero - x).
    let zero_g1 = alpha_g1 - alpha_g1;
    let neg_alpha = zero_g1 - alpha_g1;
    let neg_ic = zero_g1 - ic;
    let neg_c = zero_g1 - c_proof;

    let result = dot([a_proof, neg_alpha, neg_ic, neg_c], [b_proof, beta_g2, gamma_g2, delta_g2]);
    // `result - result` is GT additive identity — no extra pairing.
    verify(result == result - result)
}
