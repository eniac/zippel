// PST13 Multilinear Polynomial Commitment Scheme
// Reference: Papamanthou, Shi, Tamassia 2013 (PST)
//
// Generic over N variables: the polynomial p has 2^N coefficients indexed
// by {0,1}^N in lexicographic order (MSB-first, so variable 1 is the high bit).
//
// Commit: C = MSM(p, ck) = p̃(α) · g_gen, where ck[i] = eq_N(α, i) · g_gen.
//
// Open p̃(z) = y: log N quotient commitments π_1, ..., π_N. The verifier checks
//   e(C − y·g, h) == Σ_i e(π_i, α_H[i] − z_i·h).
// Equivalently (move RHS to LHS):
//   e(C − y·g, h) + Σ_i e(−π_i, α_H[i] − z_i·h) == 0_GT,
// which fuses into ONE multi_miller_loop + ONE final_exponentiation via the
// `dot(VecG1, VecG2) -> GT` arm in the backend — the same trick used by the
// Groth16 and PARI verifiers in this repo.

// =============================================================================
// eq_mle(z) — multilinear-equality basis at z, MSB-first.
//
// Returns the [F; 2^K] vector whose i-th entry is
//     eq(z, i) = Π_j ( bit_j(i) ? z[j] : 1 - z[j] ),
// where bit_j(i) = (i >> (K-1-j)) & 1 — i.e. z[0] is the high bit and is
// peeled first. This matches the recursion in `pst13_open_rounds` (which
// folds on `z_curr[0]` after splitting `p_curr` on its high half) and the
// `ck_n_scalars` construction in the Rust `prover_create_inputs`.
//
// Used in the proto's `where` clause to express the canonical PCS
// evaluation statement:  y == dot(eq_mle(z), p) == p̃(z).
// =============================================================================
fn eq_mle<G1: Group, G2: Group, GT: Pairing<G1, G2>, F: Scalar<G1, G2>>(
    public z: [F; 1]
) -> [F; 2] {
    [ 1 - z[0], z[0] ]
}
fn eq_mle<G1: Group, G2: Group, GT: Pairing<G1, G2>, F: Scalar<G1, G2>, K: 2..21>(
    public z: [F; K]
) -> [F; 2^K] {
    let a    = z[0];          // first variable = MSB (peeled first)
    let rest = z[1..K];
    let prev = eq_mle(rest);  // [F; 2^(K-1)] over the K-1 low-bit variables
    (prev * (1 - a)) ++ (prev * a)
}

// Same as eq_mle but accepts `private z`. Used by the proto's `where`
// clause to expand the trusted-setup trapdoor α into its corresponding
// Lagrange-basis weights, so the static analyzer can see the structural
// identity ck_N[i] == eq_N(α, i) · g_gen. The body is identical to
// eq_mle; only the parameter qualifier (and consequently the result
// qualifier) differs. We carry a parallel name rather than overloading
// on qualifier because qualifier-poly function dispatch isn't
// established elsewhere in the language.
fn eq_mle_priv<G1: Group, G2: Group, GT: Pairing<G1, G2>, F: Scalar<G1, G2>>(
    private z: [F; 1]
) -> [F; 2] {
    [ 1 - z[0], z[0] ]
}
fn eq_mle_priv<G1: Group, G2: Group, GT: Pairing<G1, G2>, F: Scalar<G1, G2>, K: 2..21>(
    private z: [F; K]
) -> [F; 2^K] {
    let a    = z[0];
    let rest = z[1..K];
    let prev = eq_mle_priv(rest);
    (prev * (1 - a)) ++ (prev * a)
}

// =============================================================================
// PST.Commit  (generic over M = number of variables)
//   C_p = dot(p, ck_N) = p(alpha) * G
// =============================================================================
fn pst13_commit<G1: Group, G2: Group, GT: Pairing<G1, G2>, F: Scalar<G1, G2>, M: 1..21>(
    private p: [F; 2^M],
    public ck_N: [G1; 2^M]
) -> G1 {
    dot(p, ck_N)
}

// =============================================================================
// PST.Open rounds — BASE CASE (1 variable remaining).
// Logs the final quotient commitment and returns the singleton list [π_last].
// =============================================================================
fn pst13_open_rounds<G1: Group, G2: Group, GT: Pairing<G1, G2>, F: Scalar<G1, G2>>(
    private p_curr: [F; 2],
    public ck_curr: [G1; 2],
    public z_curr: [F; 1]
) -> [G1; 1] {
    let ck_0 = ck_curr[0..1] + ck_curr[1..2];
    let p_lo = p_curr[0..1];
    let p_hi = p_curr[1..2];
    let q    = p_hi - p_lo;
    // `pi_last` is the transcript-bound name; the verifier reads it from
    // the proof transcript instead of recomputing from the private `q`.
    pi_last <- dot(q, ck_0);
    [pi_last]
}

// =============================================================================
// PST.Open rounds — RECURSIVE CASE (K >= 2 variables remaining).
// Logs π for this round, folds p at z_curr[0], recurses on K-1 variables.
// Returns the full list of π's collected across rounds.
// =============================================================================
fn pst13_open_rounds<G1: Group, G2: Group, GT: Pairing<G1, G2>, F: Scalar<G1, G2>, K: 2..21>(
    private p_curr: [F; 2^K],
    public ck_curr: [G1; 2^K],
    public z_curr: [F; K]
) -> [G1; K] {
    // ck_{K-1}[i] = ck_curr[i] + ck_curr[i + 2^(K-1)] (Lagrange-basis split).
    let ck_lo  = ck_curr[0..2^(K-1)];
    let ck_hi  = ck_curr[2^(K-1)..2^K];
    let ck_nxt = ck_lo + ck_hi;

    let p_lo = p_curr[0..2^(K-1)];
    let p_hi = p_curr[2^(K-1)..2^K];
    let q    = p_hi - p_lo;
    // `pi_curr` is transcript-bound; the verifier reads it from the proof.
    pi_curr <- dot(q, ck_nxt);

    let p_red = p_lo + (q * z_curr[0]);
    let rest  = pst13_open_rounds(p_red, ck_nxt, z_curr[1..K]);
    [pi_curr] ++ rest
}

// =============================================================================
// PST13 proto (generic over N: number of variables, 1 ≤ N ≤ 20)
//
//   Prover  →  c_p, π_1, ..., π_N
//   Verifier checks ONE fused multi_pairing:
//       dot([c_p − y·g, −π_1, ..., −π_N], [h, α_H[1] − z_1·h, ..., α_H[N] − z_N·h]) == 0_GT.
//
// All proving-key material (ck_N, alpha_H, g_gen, h_gen) is public; the
// polynomial p is private; (z, y) is the public statement.
// =============================================================================
proto pst13<G1: Group, G2: Group, GT: Pairing<G1, G2>, F: Scalar<G1, G2>, N: Size>(
    private p: [F; 2^N],         // polynomial coefficients indexed by {0,1}^N
    public z: [F; N],            // evaluation point (z_1, ..., z_N)
    public y: F,                 // claimed evaluation p(z)
    // ck_N is the prover's commitment key; the verifier doesn't reference
    // it (only α_H, g_gen, h_gen enter the pairing check). Marking it
    // `private` keeps it out of the verifier's FS sponge — at N=16 this
    // is ~3 MB of G1 the verifier would otherwise hash for no reason.
    // The verifier's binding to ck_N flows through c_p (committed via
    // `pst13_commit(p, ck_N)`) and the recursion's structure.
    private ck_N: [G1; 2^N],     // [eq_N(α, i)·G  for i in {0,1}^N]
    public g_gen: G1,
    public h_gen: G2,
    public alpha_H: [G2; N],     // [α_i · H  for i in 1..N]
    // Relation-only witness: the trusted-setup trapdoor α. The proto body
    // and the verifier do not reference it; it exists so the `where`
    // clause can declare the structural identities
    //   ck_N[i] == eq_N(α, i) · g_gen   and   alpha_H[j] == α[j] · h_gen.
    // Without these the static completeness analyzer can't close the
    // verifier's multi-pairing accumulator.
    private alpha: [F; N]
) where
    let eq_alpha = eq_mle_priv(alpha);
    y == dot(eq_mle(z), p);
    [ck_N[i] for i in 0..2^N] == [g_gen * eq_alpha[i] for i in 0..2^N];
    [alpha_H[j] for j in 0..N] == [h_gen * alpha[j] for j in 0..N]
{
    // First prover move: commitment to p.
    c_p <- pst13_commit(p, ck_N);

    // Open rounds: prover logs π_1, ..., π_N; recursion returns them as
    // an array so we can do the verifier pairing check in ONE multi_pairing.
    let pis = pst13_open_rounds(p, ck_N, z);

    // Build the multi_pairing arrays.
    //   G1 side: [c_p − y·g_gen, −π_1, ..., −π_N]
    //   G2 side: [h_gen,          α_H[1] − z_1·h_gen, ..., α_H[N] − z_N·h_gen]
    // Negation via binary subtraction (zero - x). One zero is enough; the
    // backend folds zero - pis[i] into a single G1 sub each.
    let zero_g1   = g_gen - g_gen;
    let lhs_g1    = c_p - (g_gen * y);
    let neg_pis   = [zero_g1 - pis[i] for i in 0..N];
    let g1_terms  = [lhs_g1] ++ neg_pis;
    let g2_terms  = [h_gen] ++ [alpha_H[i] - (h_gen * z[i]) for i in 0..N];

    // dot(VecG1, VecG2) → GT routes to backend's multi_pairing fast path
    // (one Miller loop + one final exp).
    let result = dot(g1_terms, g2_terms);

    // `result - result` is GT additive identity (no extra pairing).
    verify(result == result - result)
}
