proto hadamard<F: Field, S: Size, N: 1..S>(
    public p_A: Uni<F, N>,
    public p_B: Uni<F, N>,
    public p_C: Uni<F, N>,
    public v_H: Uni<F, N>
) where let zero: F = 0; poly([zero]) == (p_A * p_B - p_C) % v_H {
    let p = p_A * p_B - p_C;
    let q = p / v_H;
    r <- challenge<F>;
    left_hand <- eval(p_A, [r]) * eval(p_B, [r]) - eval(p_C, [r]);
    right_hand <- eval(q, [r]) * eval(v_H, [r]);
    verify(left_hand == right_hand)
}
