// PARI: Faster and Smaller SNARK via Equifficient Polynomial Commitments
// (Dellepere, Mishra, Shirzad — Sec USENIX 2026)
//
// PARI is a SNARK for Square R1CS (SR1CS): given matrices A, B in F^{m x k}
// and an instance/witness split z = (x, w), prove that
//   Az ∘ Az = Bz                  (Hadamard product over m constraints).
//
// This file implements PARI's prover and verifier per Fig. 6 of the paper,
// with the same matrix layout as the reference impl
// (alireza-shirzad/garuda-pari) so that the succinct-verifier Lagrange
// shortcut applies.
//
// Layout assumption (upstream "instance outliner"):
//   - Constraints 0..K-N: A's instance columns are zero (so x̂_A vanishes
//     on those K-N domain points), B's instance columns are zero
//     everywhere (so x̂_B ≡ 0 on K).
//   - Constraints K-N..K (the last N): A row = e_i (e.g. A[K-N+i][i]=1)
//     so that x̂_A(ω^{K-N+i}) = x[i].
// Under this layout, x̂_A is determined by the N instance inputs alone, and
// the verifier can compute x̂_A(r) via the closed-form Lagrange shortcut:
//   x̂_A(r) = (v_K(r) / K) · Σ_{i=0..N} omegas[i] · x[i] / (r - omegas[i])
// where omegas[i] = ω^{K-N+i}.
//
// Prover-side simplification: instead of feeding A, B as sparse matrices
// (no zippel support), the prover precomputes and feeds:
//     z_a_evals := A·z       (length K, witness)
//     z_b_evals := B·z       (length K, witness)
//     w_a_evals := A·(0∥w)   (length K, witness; = z_a_evals − x̂_A on K)
//     w_b_evals := B·(0∥w)   (length K, witness; = z_b_evals under layout)
//
// Parameters:
//   M    : log_2(K) where K is the constraint-domain size.
//   K    : number of constraints (= 2^M). K is a smooth subgroup.
//   N    : number of instance input variables (z[0]=1 plus user inputs).
//   KMN  : k - N where k = total number of variables. The witness w lives in F^KMN.
//
// Soundness in AGM (per the paper); not zero-knowledge in this version
// (omits the hiding/zk-masking that adds dummy random constraints).

proto pari<
    G1: Group,
    G2: Group,
    GT: Pairing<G1, G2>,
    F: Scalar<G1, G2>,
    M: Size,
    K: 2 ^ M,
    N: Size,
    KMN: Size,
>(
    // --- Witness side (prover-only) ---
    witness z_a_evals: [F; K], // A · z, on K
    witness z_b_evals: [F; K], // B · z, on K
    witness w_a_evals: [F; K], // A · (0∥w), on K
    witness w_b_evals: [F; K], // B · (0∥w), on K
    witness w: [F; KMN], // witness portion of z (size k-N)

    // --- Instance side (verifier-known, length N) ---
    instance x: [F; N], // instance inputs (z[0]=1, then user inputs)
    instance omegas: [F; N], // omegas[i] = ω^{K-N+i}

    // --- Setup keys (from Generator G in Fig. 6) ---
    // SRS bases are marked `extra` so they only flow to the prover
    // and don't enter the FS transcript. The native verifier doesn't
    // hash the SRS either: it binds the setup via the succinct
    // verifier key. Marking these `extra` (or worse, leaving them `instance`…
    // the FS absorption) would make the zippel verifier do O(K) hash
    // work per call, defeating the verifier-time speedup we get from
    // the Lagrange shortcut below.

    // Witness commitment basis: Σ[i] = (α a_i(τ) + β b_i(τ))/δ_2 · G,
    //   for i = n+1, …, k.
    extra sigma_w: [G1; KMN],

    // Quotient commitment basis: Σ_q[i] = τ^i / δ_2 · G, for i = 0, …, K-1.
    extra sigma_q: [G1; K],

    // Opening proof bases (no δ_1 — matches the reference impl
    // arkworks-rs/garuda-pari, which omits δ_1 entirely; δ_1 only
    // appears in the ZK variant for hiding masks).
    //   Σ_A[i]    = α τ^i · G
    //   Σ_B[i]    = β τ^i · G
    //   Σ_q'[i]   =   τ^i · G                       for i = 0, …, K-1.
    extra sigma_a: [G1; K],
    extra sigma_b: [G1; K],
    extra sigma_q_prime: [G1; K],

    // --- Verifier keys ---
    instance alpha_g: G1,
    instance beta_g: G1,
    instance g_g1: G1,
    instance delta2_h: G2, // δ_2 · H
    instance tau_h: G2, // τ · H
    instance h_g2: G2, // H

    // --- Constants supplied as inputs (avoids field-literal coercion) ---
    // v_K(X) = X^K - 1 coefficients (length K+1). Only the prover needs
    // it (to build v_K(X) for the quotient division); the verifier just
    // evaluates v_K(r) = r^K − 1 directly, so we keep this `extra` to
    // skip O(K) FS absorption.
    extra v_k_poly: Uni<F, K>,
    // The field element 1, used to negate via subtraction and to construct
    // (X - r) as a polynomial.
    instance f_one: F,
    // 1/K (mod the scalar field), precomputed by the verifier once at setup.
    instance k_inv: F,
) where
    // Trusted setup: sample the trapdoors (τ, α, β, δ_2), then derive
    // the SRS elements from them (Fig. 6 Generator).
    let tau = random<F>;
    let alpha = random<F>;
    let beta = random<F>;
    let delta2 = random<F>;
    // (1) SR1CS satisfaction on the constraint domain K:
    //       (A z) ⊙ (A z) == (B z), element-wise.
    //     With Az and Bz supplied as inputs this is the prover
    //     precondition; assert(the protocol body attests to it succinctly. [z_a_evals[i] * z_a_evals[i] for i in 0..K] == [z_b_evals[i] for i in 0..K]);assert(alpha_g == g_g1 * alpha);assert(beta_g == g_g1 * beta);assert(tau_h == h_g2 * tau);assert(delta2_h == h_g2 * delta2);
    //     Opening-proof bases: Σ_A[i] = alpha·τ^i·G, Σ_B[i] = beta·τ^i·G,
    //     Σ_ {q'}[i] = τ^i·G, all indexed by i in 0..K.
    [sigma_a[i] for i in 0..K] == [g_g1 * (alpha * tau ^ i) for i in 0..K];
    [sigma_b[i] for i in 0..K] == [g_g1 * (beta * tau ^ i) for i in 0..K];
    [sigma_q_prime[i] for i in 0..K] == [g_g1 * tau ^ i for i in 0..K];
    //     Quotient basis: Σ_q[i] = (τ^i / δ_2)·G. State multiplicatively
    //     to avoid F-division in the where clause:
    //       Σ_q[i] · δ_2 = τ^i · G.
    [sigma_q[i] * delta2 for i in 0..K] == [g_g1 * tau ^ i for i in 0..K];
    // (3) Field constants used by the verifier's Lagrange shortcut.
    f_one == 1;
    k_inv * K == 1;
    //     omegas[i] are K-th roots of unity (ω^{K-N+i}).
    [omegas[i] ^ K for i in 0..N] == [f_one for _ in 0..N]
    // (Structural identity for sigma_w — which pins the witness-side
    // basis Σ_w[i] = (α a_i(τ) + β b_i(τ))/δ_2 · G to the A/B Lagrange
    // polynomials — is intentionally omitted: it would require
    // exposing the full (a_i, b_i) polynomials as extra trapdoor
    // formal args, mirroring the groth16 QAP-witness setup. The
    // T_AB commitment binds sigma_w to (w, alpha, beta, tau, delta2)
    // transitively via the pairing check.)
{
    // === Constant scalars derived from f_one ===
    let f_zero = 0;
    let f_neg_one = f_zero - f_one;

    // === Prover: T_AB — batched commitment to ŵ_A and ŵ_B ===
    // T_AB := Σ_{i=n+1..k} w_i · Σ[i] (paper line 6).
    let t_ab = dot(w, sigma_w);

    // === Prover: quotient polynomial q(X) = (ẑ_A(X)^2 - ẑ_B(X)) / v_K(X) ===
    // Interpolate ẑ_A and ẑ_B from their evaluations on K (FFT path: unary
    // interpolate uses the standard K-th roots of unity grid).
    let z_a_poly = interpolate(z_a_evals);
    let z_b_poly = interpolate(z_b_evals);

    // v_K(X) = X^K - 1, supplied as a polynomial.
    // (Previously: poly(v_k_coeffs) from a [F; K+1] arg.)

    let z_a_sq = z_a_poly * z_a_poly;
    let num_poly = z_a_sq - z_b_poly;
    let q_poly = num_poly / v_k_poly;
    // q has degree K-2 → K-1 coefficients. Truncate sigma_q to match
    // (KZG idiom: don't pad coeffs with zero, slice the SRS instead).
    let q_coeffs = coef(q_poly);
    let sigma_q_trunc = sigma_q[0..K - 1];

    // T_Q := Σ_{i=0..K-2} q_i · Σ_q[i] (paper line 7 with implicit top
    // coefficient = 0 elided from the MSM).
    let t_q = dot(q_coeffs, sigma_q_trunc);

    // T := -(T_AB + T_Q) (paper line 8). G1 element.
    let t_value = (t_ab + t_q) * f_neg_one;
    t_proof <- t_value;

    // === Fiat-Shamir challenge ===
    r <- challenge<F>;

    // === Prover: ŵ_A, ŵ_B from precomputed w_*_evals ===
    let w_a_poly = interpolate(w_a_evals);
    let w_b_poly = interpolate(w_b_evals);

    let v_a_p = w_a_poly(r);
    let v_b_p = w_b_poly(r);

    // === Prover: opening proof U ===
    let r_neg = f_zero - r;
    let x_minus_r = poly([r_neg, f_one]);

    let w_a_witness = (w_a_poly - v_a_p) / x_minus_r;
    let w_b_witness = (w_b_poly - v_b_p) / x_minus_r;

    let q_at_r = q_poly(r);
    let w_q_witness = (q_poly - q_at_r) / x_minus_r;

    // Witness quotients: w_a, w_b have degree K-2 (K-1 coeffs);
    // w_q has degree K-3 (K-2 coeffs). Slice the SRS bases to match.
    let w_a_coeffs = coef(w_a_witness);
    let w_b_coeffs = coef(w_b_witness);
    let w_q_coeffs = coef(w_q_witness);

    let sigma_a_trunc = sigma_a[0..K - 1];
    let sigma_b_trunc = sigma_b[0..K - 1];
    let sigma_q_prime_trunc = sigma_q_prime[0..K - 2];

    let u_a = dot(w_a_coeffs, sigma_a_trunc);
    let u_b = dot(w_b_coeffs, sigma_b_trunc);
    let u_q = dot(w_q_coeffs, sigma_q_prime_trunc);

    let u_value = u_a + u_b + u_q;

    va_proof <- v_a_p;
    vb_proof <- v_b_p;
    u_proof <- u_value;

    // === Verifier: x̂_A(r) via Lagrange shortcut, x̂_B(r) = 0 ===
    // x̂_A(r) = (v_K(r) / K) · Σ_{i=0..N} omegas[i] · x[i] / (r - omegas[i])
    // (closed-form Lagrange basis on roots-of-unity, restricted to the N
    // nonzero positions [K-N, K).) O(N) field ops on the verifier instead
    // of O(K log K) IFFT.
    let v_k_at_r = r ^ K - f_one;
    let lagrange_sum = reduce(+, [omegas[i] * x[i] / (r - omegas[i]) for i in 0..N]);
    let x_a_at_r = v_k_at_r * k_inv * lagrange_sum;
    let x_b_at_r = f_zero;

    // === Verifier: v_q := ((v_a + x̂_A(r))^2 - (v_b + x̂_B(r))) / v_K(r) ===
    let lhs_a = va_proof + x_a_at_r;
    let lhs_b = vb_proof + x_b_at_r;
    let v_q = (lhs_a * lhs_a - lhs_b) / v_k_at_r;

    // === Verifier: pairing check ===
    // The native garuda-pari verifier folds all three pairs into a single
    // `multi_miller_loop + final_exponentiation`. Mirror that here: rearrange
    //   e(T, δ_2 H) + e(U, τ H) == e(r·U − V·G, H)
    // to
    //   e(T, δ_2 H) + e(U, τ H) + e(V·G − r·U, H) == 0_GT
    // (negating the G1 side of the third term flips its sign in additive GT)
    // so all three pairs land in one `dot(VecG1, VecG2) -> GT`. The check
    // against identity uses `result == result - result`: `result - result` is
    // GT additive identity (cheap field subtraction, no extra pairings), so
    // the verifier pays exactly one final exponentiation — same as native.
    // Fold the 4-term linear combination α·v_a + β·v_b + G·v_q − r·U into
    // a single Pippenger MSM (matches the native verifier's
    // `msm_bigint_wnaf(&[α, β, G, −U], &[v_a, v_b, v_q, r])` call). Without
    // this, each of the 4 group-scalar muls dispatches as a separate graph
    // node, losing Pippenger bucketing AND paying per-node scheduling cost.
    let neg_r = f_zero - r;
    let inner = dot([va_proof, vb_proof, v_q, neg_r], [alpha_g, beta_g, g_g1, u_proof]);

    let result = dot([t_proof, u_proof, inner], [delta2_h, tau_h, h_g2]);
    verify(result == result - result)
}
