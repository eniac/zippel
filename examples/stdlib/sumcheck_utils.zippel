
fn marginalize_from_prefix_mle<F: Field, FIXED: 1..32, TAIL: 1..32>(
    public p: Mle<F, FIXED + 1 + TAIL>,
    public fixed_prefix: [F; FIXED]
) -> Poly<F, 1, 2> {
    // Build 0/1 as field elements.
    let zero = fixed_prefix[0] - fixed_prefix[0];
    let one = zero + 1;

    // Enumerate all boolean assignments for tail variables.
    // Convert bit digits into field elements so concatenation is type-aligned.
    let tails = [
        [(((i / (2^j)) % 2) * one) for j in 0..TAIL]
        for i in 0..2^TAIL
    ];

    // g(0): keep variable fixed to 0 and sum over tail assignments.
    let g0_terms = [eval(p, fixed_prefix ++ [zero] ++ tail) for tail in tails];
    let g0 = reduce(+, g0_terms);

    // g(1): keep variable fixed to 1 and sum over tail assignments.
    let g1_terms = [eval(p, fixed_prefix ++ [one] ++ tail) for tail in tails];
    let g1 = reduce(+, g1_terms);

    // Interpolate affine polynomial from values at 0 and 1.
    poly([g0, g1 - g0])
}


fn marginalize_from_prefix_virtual<F: Field, FIXED: 1..32, TAIL: 1..32, MAX_DEG: 1..32>(
    public p: Poly<F, FIXED + 1 + TAIL, MAX_DEG + 1>,
    public fixed_prefix: [F; FIXED]
) -> [F; MAX_DEG + 1] {
    let zero = fixed_prefix[0] - fixed_prefix[0];
    let one = zero + 1;

    // Enumerate boolean assignments for all tail variables.
    let tails = [
        [(((i / (2^j)) % 2) * one) for j in 0..TAIL]
        for i in 0..2^TAIL
    ];

    // Evaluate g(t) for each t in {0,1,...,MAX_DEG} by fixing prefix and
    // summing over the boolean hypercube of remaining variables.
    let eval_points = [i * one for i in 0..MAX_DEG + 1];
    [reduce(+, [eval(p, fixed_prefix ++ [t] ++ tail) for tail in tails]) for t in eval_points]
}
