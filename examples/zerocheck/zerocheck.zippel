proto univariate_zero_check<F: Field, S: Size, N: S>(
    instance p: Uni<F, N>,
    instance v: Uni<F, N>
) where p % v == poly([0]) {
    q <- p / v;
    r <- challenge<F>;
    let left_hand = p(r);
    let right_hand = q(r) * v(r);
    verify(left_hand == right_hand)
    // verify(p(r) == q(r) * v(r));
}