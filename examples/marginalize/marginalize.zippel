// Self-contained compile/lowering tests for a generic non-recursive
// Zippel-level marginalize helper.
//
// NOTE: Keep test concretization bounds narrow to avoid compile-time blowups.

fn marginalize_from_prefix_mle<F: Field, FIXED: 2..6, TAIL: 1..2>(
    public p: Mle<F, FIXED + 1 + TAIL>,
    public fixed_prefix: [F; FIXED]
) -> Poly<F, 1, 2> {
    let zero = fixed_prefix[0] - fixed_prefix[0];
    let one = zero + 1;

    let tails = [
        [(((i / (2^j)) % 2) * one) for j in 0..TAIL]
        for i in 0..2^TAIL
    ];

    let g0_terms = [eval(p, fixed_prefix ++ [zero] ++ tail) for tail in tails];
    let g0 = reduce(+, g0_terms);

    let g1_terms = [eval(p, fixed_prefix ++ [one] ++ tail) for tail in tails];
    let g1 = reduce(+, g1_terms);

    poly([g0, g1 - g0])
}

proto marginalize_test_fixed2<F: Field>(
    public x: F
) where (x == x) {
    // MU=4, FIXED=2, TAIL=1
    // With index order used by this compiler:
    // q(0)=4+5=9, q(1)=6+7=13 => coeffs [9, 4]
    let p = mle([i for i in 0..16]);
    let q = marginalize_from_prefix_mle(p, [0, 1]);
    let q_coeffs = coef(q);
    verify(q_coeffs[0] == 9 && q_coeffs[1] == 4);
}

proto marginalize_test_fixed3<F: Field>(
    public x: F
) where (x == x) {
    // MU=5, FIXED=3, TAIL=1
    // q(0)=20+21=41, q(1)=22+23=45 => coeffs [41, 4]
    let p = mle([i for i in 0..32]);
    let q = marginalize_from_prefix_mle(p, [1, 0, 1]);
    let q_coeffs = coef(q);
    verify(q_coeffs[0] == 41 && q_coeffs[1] == 4);
}

proto marginalize_test_fixed4<F: Field>(
    public x: F
) where (x == x) {
    // MU=6, FIXED=4, TAIL=1
    // fixed_prefix=[1,1,0,1] => base index 52
    // q(0)=52+53=105, q(1)=54+55=109 => coeffs [105, 4]
    let p = mle([i for i in 0..64]);
    let q = marginalize_from_prefix_mle(p, [1, 1, 0, 1]);
    let q_coeffs = coef(q);
    verify(q_coeffs[0] == 105 && q_coeffs[1] == 4);
}

proto marginalize_test_fixed5<F: Field>(
    public x: F
) where (x == x) {
    // MU=7, FIXED=5, TAIL=1
    // fixed_prefix=[1,0,1,1,0] => base index 88
    // q(0)=88+89=177, q(1)=90+91=181 => coeffs [177, 4]
    let p = mle([i for i in 0..128]);
    let q = marginalize_from_prefix_mle(p, [1, 0, 1, 1, 0]);
    let q_coeffs = coef(q);
    verify(q_coeffs[0] == 177 && q_coeffs[1] == 4);
}
