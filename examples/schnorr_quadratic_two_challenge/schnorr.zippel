proto schnorr<G: Group, F: Scalar<G>>(private x: F, public g: G, public h: G) where h == g*x {
    let r = random<F>;
    let s = random<F>;

    u <- g*r;
    v <- g*s;

    c1 <- challenge<F*>;
    c2 <- challenge<F*>;

    z1 <- r + x*c1;
    z2 <- s + r*c2 + x*(c1*c2) + x*(c2*c2);

    verify(
        g*z1 == u + h*c1 &&
        g*z2 == v + u*c2 + h*(c1*c2 + c2*c2)
    )
}