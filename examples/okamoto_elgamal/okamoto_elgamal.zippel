proto okamoto_elgamal<G: Group, F: Scalar<G>>(
    // Perfectly binding ElGamal commitment: g must be a generator of G.
    witness x: F,
    witness r: F,
    instance g: G,
    instance h: G,
    instance c1: G,
    instance c2: G,
) where
    c1 == g * r;
    c2 == h * r + g * x
{
    let rx = random<F>;
    let rr = random<F>;
    t1 <- g * rr;
    t2 <- h * rr + g * rx;
    c <- challenge<F*>;
    sx <- rx + x * c;
    sr <- rr + r * c;
    verify(g * sr == t1 + c1 * c);
    verify(h * sr + g * sx == t2 + c2 * c)
}
