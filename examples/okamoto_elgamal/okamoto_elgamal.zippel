proto okamoto_elgamal<G: Group, F: Scalar<G>>(
    // Perfectly binding ElGamal commitment: g must be a generator of G.
    private x: F,
    private r: F,
    public g: G,
    public h: G,
    public c1: G,
    public c2: G
) where c1 == g*r && c2 == h*r + g*x {
    let rx = random<F>;
    let rr = random<F>;
    t1 <- g*rr;
    t2 <- h*rr + g*rx;
    c <- challenge<F*>;
    sx <- rx + x*c;
    sr <- rr + r*c;
    verify(g*sr == t1 + c1*c && h*sr + g*sx == t2 + c2*c)
}
