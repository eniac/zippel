proto mle<F: Field>(
    // --- Public Inputs ---
    public x: F
) where (x == x) {

    // let mle1 = poly([1, 2, 3, 4]); // mle([0, 1, 2, 6]);
    

    // let test = eval(mle1, [5]);
    // let mle2 = mle([5, 22]);

    let p = poly([x, x]); 
    // mle([2, 3, 2, 6]);
    // let epoint = eval(p, [1, 17]);

    // point1 <- challenge<F>;
    // point2 <- challenge<F>;

    let epoint2 = eval(p, [x]);
    // let epoint2 = x;
    epoint1 <- epoint2;
    // let epoint1 = epoint2;

    // verify(epoint2 == eval(p, [point1, point2])) // && test == mle2  && epoint == 54);
    verify(p == p && epoint1 == epoint1);
}