// KZH-2 polynomial commitment scheme (Figure 2 of KZH-Fold paper).
//
// Flow:
//   1. Prover commits (sends c_commit).
//   2. Verifier samples evaluation point (x0, y0) via challenges.
//   3. Prover opens (sends pi_vals = f*(Y) evaluations and claimed value z0).
//   4. Verifier checks the three Figure-2 equations.
//
// Dimensions are hardcoded to NX = NY = 2 (2^NX = 2^NY = 4, 2^(NX+NY) = 16)
// because the current grammar doesn't allow size expressions like `2^NX`
// in proto parameter types and has no array-of-challenges primitive.

fn eq_weights<G1: Group, G2: Group, GT: Pairing<G1, G2>, F: Scalar<G1, G2>>(
    public x: [F; 1]
) -> [F; 2] {
    [ (1 - x[0]), x[0] ]
}

fn eq_weights<G1: Group, G2: Group, GT: Pairing<G1, G2>, F: Scalar<G1, G2>, K: 2..16>(
    public x: [F; K]
) -> [F; 2^K] {
    let x_lo = x[0..(K-1)];
    let a = x[K-1];
    let prev = eq_weights(x_lo);
    (prev * (1 - a)) ++ (prev * a)
}

// Private-input variant of eq_weights, used by the proto's `where`
// clause to expand the trusted-setup trapdoors (tau_x, tau_y) into
// their Lagrange-basis weights so the SRS tensor identity can be
// declared structurally. Body is identical; only the qualifier differs
// (qualifier-poly function dispatch isn't established elsewhere).
fn eq_weights_priv<G1: Group, G2: Group, GT: Pairing<G1, G2>, F: Scalar<G1, G2>>(
    private x: [F; 1]
) -> [F; 2] {
    [ (1 - x[0]), x[0] ]
}

fn eq_weights_priv<G1: Group, G2: Group, GT: Pairing<G1, G2>, F: Scalar<G1, G2>, K: 2..16>(
    private x: [F; K]
) -> [F; 2^K] {
    let x_lo = x[0..(K-1)];
    let a = x[K-1];
    let prev = eq_weights_priv(x_lo);
    (prev * (1 - a)) ++ (prev * a)
}

proto kzh<
    G1: Group, G2: Group, GT: Pairing<G1, G2>, F: Scalar<G1, G2>
>(
    private f_evals: [F; 16],
    public h_xy:    [G1; 16],
    public h_y:     [G1; 4],
    public d_x:     [G1; 4],
    public v_prime: G2,
    public v_x:     [G2; 4],
    // Relation-only trapdoor witnesses (analogous to pst13's private
    // alpha). Body/verifier don't reference these; the `where` clause
    // uses them to declare the KZH-2 SRS tensor structure.
    private g_gen:  G1,
    private tau_x:  [F; 2],
    private tau_y:  [F; 2]
) where
    // KZH-2 SRS tensor structure at the trapdoor (τ_x, τ_y):
    //   H^{i,j} = g · eq(τ_x, i_bits) · eq(τ_y, j_bits)
    //   D^i    = g · eq(τ_x, i_bits)
    //   H^j    = g · eq(τ_y, j_bits)
    // This captures the x-marginal (d_x) and y-marginal (h_y) of the
    // full 2D tensor h_xy under the same generator, which is the
    // structural identity that makes the Fig. 2 pairing check
    //   e(C, V') == Σ_x e(D^x, V^x)
    // succeed for correctly-formed commitments. The V' / V^x tie to a
    // separate G2 trapdoor is intentionally left off — it would
    // require exposing h_gen and the y-trapdoor lift, which is more
    // machinery than the analyzer needs for the primary tensor claim.
    let eq_x = eq_weights_priv(tau_x);
    let eq_y = eq_weights_priv(tau_y);
    reduce(&&, [h_xy[k] == g_gen * (eq_x[k / 4] * eq_y[k % 4]) for k in 0..16])
    && reduce(&&, [d_x[i] == g_gen * eq_x[i] for i in 0..4])
    && reduce(&&, [h_y[j] == g_gen * eq_y[j] for j in 0..4])
{
    // -------- Phase 1: commit --------
    let c = dot(f_evals, h_xy);
    c_commit <- c;

    // -------- Phase 2: verifier samples the evaluation point --------
    cx0 <- challenge<F>;
    cx1 <- challenge<F>;
    cy0 <- challenge<F>;
    cy1 <- challenge<F>;
    let x0 = [cx0, cx1];
    let y0 = [cy0, cy1];

    // -------- Phase 3: open --------
    let eqx = eq_weights(x0);
    let eqy = eq_weights(y0);

    // pi_vals[y] = sum_x eq(x, x0) * f(x, y)
    let pi_vals = [
        reduce(+, [eqx[xi] * f_evals[xi * 4 + yi] for xi in 0..4])
        for yi in 0..4
    ];
    pi <- pi_vals;

    // Claimed value z0 = f*(y0) = sum_y eq(y, y0) * pi_vals[y]
    let z = reduce(+, [pi_vals[yi] * eqy[yi] for yi in 0..4]);
    z0 <- z;

    // -------- Phase 4: verify --------
    // The verifier only uses the sent values: c_commit, pi, z0.
    // Check 1 (pairing): e(C, V') == sum_x e(D^(x), V^(x))
    let check1 = pair(c_commit, v_prime) == reduce(+, pair(d_x, v_x));

    // Check 2 (G1 MSM): sum_y f*(y) H^(y) == sum_x eq(x, x0) D^(x)
    let check2 = dot(pi, h_y) == dot(eqx, d_x);

    // Check 3: f*(y0) == z0, where f*(y0) = sum_y eq(y, y0) * pi[y].
    let claim = reduce(+, [pi[yi] * eqy[yi] for yi in 0..4]);
    let check3 = claim == z0;

    verify(check1 && check2 && check3)
}
