// KZH-2 polynomial commitment scheme (Figure 2 of KZH-Fold paper).
//
// Flow:
//   1. Prover commits (sends c_commit).
//   2. Verifier samples evaluation point (x0, y0) via challenges.
//   3. Prover opens (sends pi_vals = f*(Y) evaluations and claimed value z0).
//   4. Verifier checks the three Figure-2 equations.
//
// Generic over NX, NY (log-dimensions): 2^NX × 2^NY grid, 2^(NX+NY) evals.

fn eq_weights<G1: Group, G2: Group, GT: Pairing<G1, G2>, F: Scalar<G1, G2>>(
    instance x: [F; 1],
) -> [F; 2] {
    [1 - x[0], x[0]]
}

fn eq_weights<G1: Group, G2: Group, GT: Pairing<G1, G2>, F: Scalar<G1, G2>, K: 2..16>(
    instance x: [F; K],
) -> [F; 2 ^ K] {
    let x_lo = x[0..K - 1];
    let a = x[K - 1];
    let prev = eq_weights(x_lo);
    (prev * (1 - a)) ++ (prev * a)
}

proto kzh<
    G1: Group,
    G2: Group,
    GT: Pairing<G1, G2>,
    F: Scalar<G1, G2>,
    NX: Size,
    NY: Size,
    NXV: 2 ^ NX,
    NYV: 2 ^ NY,
    NXY: 2 ^ (NX + NY),
>(
    witness f_evals: [F; NXY],
    instance h_xy: [G1; NXY],
    instance h_y: [G1; NYV],
    instance d_x: [G1; NXV],
    instance v_prime: G2,
    instance v_x: [G2; NXV],
    instance g_gen: G1,
    instance h_gen: G2,
) where
    // Trusted setup: sample the trapdoors (τ_x, τ_y), then derive the
    // KZH-2 SRS tensor structure at those trapdoors.
    //   H^ {i,j} = g · eq(τ_x, i_bits) · eq(τ_y, j_bits)
    //   D^i    = g · eq(τ_x, i_bits)
    //   H^j    = g · eq(τ_y, j_bits)
    //   V^i    = h · eq(τ_x, i_bits),   V' = h.
    // The pairing check e(C, V') == Σ_x e(D^x, V^x) then verifies that
    // C is well-formed. eq_weights inlined LSB-first (bit_j(k) =
    // (k / 2^j) % 2) because the analyzer can't dispatch recursive
    // function calls inside `where`.
    let tau_x = [random<F> for _ in 0..NX];
    let tau_y = [random<F> for _ in 0..NY];
    let eq_x = [
        reduce(
            *,
            [tau_x[j] * (k / 2 ^ j % 2) + (1 - tau_x[j]) * (1 - k / 2 ^ j % 2) for j in 0..NX],
        )
        for k in 0..NXV
    ];
    let eq_y = [
        reduce(
            *,
            [tau_y[j] * (k / 2 ^ j % 2) + (1 - tau_y[j]) * (1 - k / 2 ^ j % 2) for j in 0..NY],
        )
        for k in 0..NYV
    ];
    [h_xy[k] for k in 0..NXY] == [g_gen * (eq_x[k / NYV] * eq_y[k % NYV]) for k in 0..NXY];
    [d_x[i] for i in 0..NXV] == [g_gen * eq_x[i] for i in 0..NXV];
    [h_y[j] for j in 0..NYV] == [g_gen * eq_y[j] for j in 0..NYV];
    v_prime == h_gen;
    [v_x[i] for i in 0..NXV] == [h_gen * eq_x[i] for i in 0..NXV]
{
    // -------- Phase 1: commit --------
    let c = dot(f_evals, h_xy);
    c_commit <- c;

    // -------- Phase 2: verifier samples the evaluation point --------
    let x0 = [challenge<F> for _ in 0..NX];
    let y0 = [challenge<F> for _ in 0..NY];

    // -------- Phase 3: open --------
    let eqx = eq_weights(x0);
    let eqy = eq_weights(y0);

    // pi_vals[y] = sum_x eq(x, x0) * f(x, y)
    let pi_vals = [reduce(+, [eqx[xi] * f_evals[xi * NYV + yi] for xi in 0..NXV]) for yi in 0..NYV];
    pi <- pi_vals;

    // Claimed value z0 = f*(y0) = sum_y eq(y, y0) * pi_vals[y]
    let z = reduce(+, [pi_vals[yi] * eqy[yi] for yi in 0..NYV]);
    z0 <- z;

    // -------- Phase 4: verify --------
    // The verifier only uses the sent values: c_commit, pi, z0.
    // Check 1 (pairing): e(C, V') == sum_x e(D^(x), V^(x))
    verify(pair(c_commit, v_prime) == reduce(+, pair(d_x, v_x)));

    // Check 2 (G1 MSM): sum_y f*(y) H^(y) == sum_x eq(x, x0) D^(x)
    verify(dot(pi, h_y) == dot(eqx, d_x));

    // Check 3: f*(y0) == z0, where f*(y0) = sum_y eq(y, y0) * pi[y].
    let claim = reduce(+, [pi[yi] * eqy[yi] for yi in 0..NYV]);
    verify(claim == z0)
}
