// KZH-2 multilinear polynomial commitment: KZH-k (Figure 12 of KZH-Fold,
// https://eprint.iacr.org/2025/144) at k = 2, following irondict's
// `pcs/kzhk` (commit, dense open at an arbitrary point, non-zk verify).
//
// f has NX + NY variables; its evaluation table is a 2^NX × 2^NY matrix T,
// T[x][y] = f[x * NYV + y]. The point is (x0, y0): x0 binds the row block
// (the high variables), y0 the column block; x0[0] and y0[0] are the low
// bits of their blocks, as in irondict's `build_eq_x_r` / `fix_last_variables`.

fn eq_weights<F: Field>(instance x: [F; 1]) -> [F; 2] {
    [1 - x[0], x[0]]
}

fn eq_weights<F: Field, K: 2..16>(instance x: [F; K]) -> [F; 2 ^ K] {
    let x_lo = x[0..K - 1];
    let a = x[K - 1];
    let prev = eq_weights(x_lo);
    (prev * (1 - a)) ++ (prev * a)
}

proto kzh<
    G1: Group,
    G2: Group,
    GT: Pairing<G1, G2>,
    F: Scalar<G1, G2>,
    NX: Size,
    NY: Size,
    NXV: 2 ^ NX,
    NYV: 2 ^ NY,
    NXY: 2 ^ (NX + NY),
>(
    witness f: [F; NXY],
    // Statement: f(x0, y0) = z0
    instance x0: [F; NX],
    instance y0: [F; NY],
    instance z0: F,
    // SRS: H1[x, y] = µ1_x µ2_y G (prover only), H2[y] = µ2_y G, V1[x] = µ1_x V
    extra h1: [G1; NXY],
    instance h2: [G1; NYV],
    instance v1: [G2; NXV],
    instance v_gen: G2,
    instance g_gen: G1,
) where
    // Trusted setup: sample the trapdoors µ1, µ2 and derive the SRS.
    let mu1 = [random<F> for _ in 0..NXV];
    let mu2 = [random<F> for _ in 0..NYV];
    let eqx = eq_weights(x0);
    let eqy = eq_weights(y0);
    z0 == dot([eqx[k / NYV] * eqy[k % NYV] for k in 0..NXY], f)
        && reduce(
            &&,
            [h1[k] for k in 0..NXY] == [g_gen * (mu1[k / NYV] * mu2[k % NYV]) for k in 0..NXY],
        )
        && reduce(&&, [h2[y] for y in 0..NYV] == [g_gen * mu2[y] for y in 0..NYV])
        && reduce(&&, [v1[x] for x in 0..NXV] == [v_gen * mu1[x] for x in 0..NXV])
{
    // Commit: C = <T, H1>
    c <- dot(f, h1);

    // Open (j = 1): D[x] = <T[x], H2> and T2 = <T, eq(x0)>
    d <- [dot([f[x * NYV + y] for y in 0..NYV], h2) for x in 0..NXV];
    let eqx = eq_weights(x0);
    t2 <- [dot(eqx, [f[x * NYV + y] for x in 0..NXV]) for y in 0..NYV];

    // Verify 1: e(C, V) == Σ_x e(D[x], V1[x]), as one multi-pairing
    let zero_g1 = g_gen - g_gen;
    let pairing = dot([zero_g1 - c] ++ d, [v_gen] ++ v1);
    verify(pairing == pairing - pairing);

    // Verify 2: C1 = <eq(x0), D> == <T2, H2>
    verify(dot(eqx, d) == dot(t2, h2));

    // Verify 3: <T2, eq(y0)> == z0
    let eqy = eq_weights(y0);
    verify(dot(t2, eqy) == z0)
}
