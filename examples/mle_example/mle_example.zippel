proto mle<F: Field>(
    // --- Public Inputs ---
    public x: F
) where (x == x) {

    // let mle1 = mle([0, 1, 2, 6]);

    // let mle_fixed = eval(mle1, [5]);

    // let mle2 = mle([3, 12]);

    // let mle_sum = mle1 + mle2; 

    mlex <- mle([4, 12]);
    let mle2 = mle([3, 12]);
    let mle_res = mle([2, 6]);
    let mlesum = mlex / 2;
    verify(mle_res == mlesum);
    
}