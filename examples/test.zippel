fn sum_recursive<F: Field>(
    public sum_vec: [F; 1]
) -> Bool {
        // BASE CASE (n=1)
        
        sum_vec == sum_vec
}

fn sum_recursive<F: Field, N_current: 1..6>(
    public sum_vec: [F; 2^N_current]         
) -> Bool {
        temp <- random<F>;
        temp_transcript <- temp*temp;

        temp_transcript == temp*temp && sum_recursive(sum_vec[0..2^(N_current-1)]) && sum_recursive(sum_vec[2^(N_current-1)..2^N_current])
        //let sum_vec_next = sum_vec[0..2^(N_current - 1)];
        //sum_recursive(sum_vec_next)
        //sum_vec == sum_vec
}

proto sum_test<F: Field, N_val_const: 4>(
    // --- Public Inputs ---
    public sum_vec: [F; N_val_const] 
) where
        (sum_vec == sum_vec) {
    let verification_result = sum_recursive(
                                            sum_vec
                                        );

    verify(verification_result);
}
