// Protocol 14 from Thaler's book but with asymmetric pairings (since symmetric is not OK)
// Dory Evaluation Proof (Inner Product Argument using Bilinear Pairings)
// This proves knowledge of vectors u in G1^n and g in G2^n such that:
// c1 = <u, g>
// c2 = <u, gamma2>
// c3 = <g, gamma1>
// Where <a, b> represents the inner pairing product (IPP).
//
// The generators gamma1, gamma2 (and the halves gamma1_prime, gamma2_prime)
// are the public proving key, so they are `extra`: only the prover reads
// them. The verifier instead reads the preprocessed verifier key (the
// per-level hash and IPP values, plus the final generators), and the `where`
// clause states how that key is derived from the generators.

// Base Case (n = 1) -> maps to LOG_N=0 in power
fn dory_reduce<G1: Group, G2: Group, GT: Pairing<G1, G2>, F: Scalar<G1, G2>>(
    instance c1: GT,
    instance c2: GT,
    instance c3: GT,
    instance final_gamma1: G1,
    instance final_gamma2: G2,
    witness u_vec: [G1; 1],
    witness g_vec: [G2; 1],
) -> Unit {
    // Prover sends u and g
    log_u <- u_vec[0];
    log_g <- g_vec[0];

    // Verifier checks
    verify(c1 == pair(log_u, log_g));
    verify(c2 == pair(log_u, final_gamma2));
    verify(c3 == pair(final_gamma1, log_g))
}

// Intermediate case: LOG_N = 1 (size = 2 elements).
// Here we recurse down to array size = 1 (LOG_N=0).
fn dory_reduce<G1: Group, G2: Group, GT: Pairing<G1, G2>, F: Scalar<G1, G2>>(
    instance c1: GT,
    instance c2: GT,
    instance c3: GT,
    instance hash1_l_vec: [GT; 1],
    instance hash1_r_vec: [GT; 1],
    instance hash2_l_vec: [GT; 1],
    instance hash2_r_vec: [GT; 1],
    instance gamma_pair_ipp_vec: [GT; 1],
    instance final_gamma1: G1,
    instance final_gamma2: G2,

    // Proving key: the public generators, read only by the prover
    extra gamma1: [G1; 2],
    extra gamma2: [G2; 2],
    extra gamma1_prime: [G1; 1],
    extra gamma2_prime: [G2; 1],

    // Prover's witness state
    witness u_vec: [G1; 2],
    witness g_vec: [G2; 2],
) -> Unit {
    // 1. Prover computes left/right commitments using the next level's bases
    let u_l = u_vec[0..1];
    let u_r = u_vec[1..2];
    let g_l = g_vec[0..1];
    let g_r = g_vec[1..2];

    let _gamma1_l = gamma1[0..1];
    let _gamma1_r = gamma1[1..2];
    let _gamma2_l = gamma2[0..1];
    let _gamma2_r = gamma2[1..2];

    let hash1_l = hash1_l_vec[0];
    let hash1_r = hash1_r_vec[0];
    let hash2_l = hash2_l_vec[0];
    let hash2_r = hash2_r_vec[0];
    let gamma_pair_ipp = gamma_pair_ipp_vec[0];

    // Prover verifies hash structures privately, but Verifier uses the instance hashes provided

    let d1_l = reduce(+, [pair(u_l[0], gamma2_prime[0]) for _ in 0..1]);
    let d1_r = reduce(+, [pair(u_r[0], gamma2_prime[0]) for _ in 0..1]);
    let d2_l = reduce(+, [pair(gamma1_prime[0], g_l[0]) for _ in 0..1]);
    let d2_r = reduce(+, [pair(gamma1_prime[0], g_r[0]) for _ in 0..1]);

    log_d1l <- d1_l;
    log_d1r <- d1_r;
    log_d2l <- d2_l;
    log_d2r <- d2_r;

    rho <- challenge<F>;
    let rho_inv = 1 / rho;

    let w1 = u_vec + gamma1 * rho;
    let w2 = g_vec + gamma2 * rho_inv;

    let w1_l = w1[0..1];
    let w1_r = w1[1..2];
    let w2_l = w2[0..1];
    let w2_r = w2[1..2];

    let v_l = reduce(+, [pair(w1_l[0], w2_r[0]) for _ in 0..1]);
    let v_r = reduce(+, [pair(w1_r[0], w2_l[0]) for _ in 0..1]);

    log_vl <- v_l;
    log_vr <- v_r;

    alpha <- challenge<F>;
    let alpha_inv = 1 / alpha;
    let alpha_sq = alpha * alpha;
    let alpha_inv_sq = alpha_inv * alpha_inv;

    let u_prime = w1_l * alpha + w1_r * alpha_inv;
    let g_prime = w2_l * alpha_inv + w2_r * alpha;

    let c1_prime = c1
        + rho_inv * c2
        + rho * c3
        + gamma_pair_ipp
        + alpha_sq * log_vl
        + alpha_inv_sq * log_vr;
    let c2_prime = alpha * log_d1l
        + alpha_inv * log_d1r
        + alpha * rho * hash1_l
        + alpha_inv * rho * hash1_r;
    let c3_prime = alpha_inv * log_d2l
        + alpha * log_d2r
        + alpha_inv * rho_inv * hash2_l
        + alpha * rho_inv * hash2_r;

    dory_reduce(c1_prime, c2_prime, c3_prime, final_gamma1, final_gamma2, u_prime, g_prime)
}

// Recursive Step (LOG_N > 2)
fn dory_reduce<
    G1: Group,
    G2: Group,
    GT: Pairing<G1, G2>,
    F: Scalar<G1, G2>,
    S: Size,
    LOG_N: 2..S + 1,
>(
    instance c1: GT,
    instance c2: GT,
    instance c3: GT,
    // Preprocessed evaluations
    instance hash1_l_vec: [GT; LOG_N],
    instance hash1_r_vec: [GT; LOG_N],
    instance hash2_l_vec: [GT; LOG_N],
    instance hash2_r_vec: [GT; LOG_N],
    instance gamma_pair_ipp_vec: [GT; LOG_N],
    instance final_gamma1: G1,
    instance final_gamma2: G2,

    // Proving key: the public generators, read only by the prover
    extra gamma1: [G1; 2 ^ LOG_N],
    extra gamma2: [G2; 2 ^ LOG_N],
    extra gamma1_prime: [G1; 2 ^ (LOG_N - 1)],
    extra gamma2_prime: [G2; 2 ^ (LOG_N - 1)],

    // Prover's witness state
    witness u_vec: [G1; 2 ^ LOG_N],
    witness g_vec: [G2; 2 ^ LOG_N],
) -> Unit {
    // 1. Prover computes left/right commitments using the next level's bases
    let u_l = u_vec[0..2 ^ (LOG_N - 1)];
    let u_r = u_vec[2 ^ (LOG_N - 1)..2 ^ LOG_N];
    let g_l = g_vec[0..2 ^ (LOG_N - 1)];
    let g_r = g_vec[2 ^ (LOG_N - 1)..2 ^ LOG_N];

    let _gamma1_l = gamma1[0..2 ^ (LOG_N - 1)];
    let _gamma1_r = gamma1[2 ^ (LOG_N - 1)..2 ^ LOG_N];
    let _gamma2_l = gamma2[0..2 ^ (LOG_N - 1)];
    let _gamma2_r = gamma2[2 ^ (LOG_N - 1)..2 ^ LOG_N];

    let hash1_l = hash1_l_vec[0];
    let hash1_r = hash1_r_vec[0];
    let hash2_l = hash2_l_vec[0];
    let hash2_r = hash2_r_vec[0];
    let gamma_pair_ipp = gamma_pair_ipp_vec[0];

    // Prover verifies hash structures privately, but Verifier uses the instance hashes provided

    let d1_l = reduce(+, [pair(u_l[i], gamma2_prime[i]) for i in 0..2 ^ (LOG_N - 1)]);
    let d1_r = reduce(+, [pair(u_r[i], gamma2_prime[i]) for i in 0..2 ^ (LOG_N - 1)]);
    let d2_l = reduce(+, [pair(gamma1_prime[i], g_l[i]) for i in 0..2 ^ (LOG_N - 1)]);
    let d2_r = reduce(+, [pair(gamma1_prime[i], g_r[i]) for i in 0..2 ^ (LOG_N - 1)]);

    // Prover sends D terms to the transcript
    log_d1l <- d1_l;
    log_d1r <- d1_r;
    log_d2l <- d2_l;
    log_d2r <- d2_r;

    // 2. Verifier sends rho
    rho <- challenge<F>;
    let rho_inv = 1 / rho;

    // 3. Prover logic
    let w1 = u_vec + gamma1 * rho;
    let w2 = g_vec + gamma2 * rho_inv;

    let w1_l = w1[0..2 ^ (LOG_N - 1)];
    let w1_r = w1[2 ^ (LOG_N - 1)..2 ^ LOG_N];
    let w2_l = w2[0..2 ^ (LOG_N - 1)];
    let w2_r = w2[2 ^ (LOG_N - 1)..2 ^ LOG_N];

    // 4. Prover sends v_L and v_R
    let v_l = reduce(+, [pair(w1_l[i], w2_r[i]) for i in 0..2 ^ (LOG_N - 1)]);
    let v_r = reduce(+, [pair(w1_r[i], w2_l[i]) for i in 0..2 ^ (LOG_N - 1)]);

    log_vl <- v_l;
    log_vr <- v_r;

    // 5. Verifier checks and sends alpha
    alpha <- challenge<F>;
    let alpha_inv = 1 / alpha;
    let alpha_sq = alpha * alpha;
    let alpha_inv_sq = alpha_inv * alpha_inv;

    // 6. Prover computes new u' and g'
    let u_prime = w1_l * alpha + w1_r * alpha_inv;
    let g_prime = w2_l * alpha_inv + w2_r * alpha;

    let c1_prime = c1
        + rho_inv * c2
        + rho * c3
        + gamma_pair_ipp
        + alpha_sq * log_vl
        + alpha_inv_sq * log_vr;
    let c2_prime = alpha * log_d1l
        + alpha_inv * log_d1r
        + alpha * rho * hash1_l
        + alpha_inv * rho * hash1_r;
    let c3_prime = alpha_inv * log_d2l
        + alpha * log_d2r
        + alpha_inv * rho_inv * hash2_l
        + alpha * rho_inv * hash2_r;

    let next_gamma1_prime = gamma1_prime[0..2 ^ (LOG_N - 2)];
    let next_gamma2_prime = gamma2_prime[0..2 ^ (LOG_N - 2)];

    let next_hash1_l_vec = hash1_l_vec[1..LOG_N];
    let next_hash1_r_vec = hash1_r_vec[1..LOG_N];
    let next_hash2_l_vec = hash2_l_vec[1..LOG_N];
    let next_hash2_r_vec = hash2_r_vec[1..LOG_N];
    let next_gamma_pair_ipp_vec = gamma_pair_ipp_vec[1..LOG_N];

    dory_reduce(
        c1_prime,
        c2_prime,
        c3_prime,
        next_hash1_l_vec,
        next_hash1_r_vec,
        next_hash2_l_vec,
        next_hash2_r_vec,
        next_gamma_pair_ipp_vec,
        final_gamma1,
        final_gamma2,
        gamma1_prime,
        gamma2_prime,
        next_gamma1_prime,
        next_gamma2_prime,
        u_prime,
        g_prime,
    )
}

// Verifier key: the preprocessed values the verifier reads at each level
// match the generators. Mirrors dory_reduce's recursion: the next level's
// gamma is this level's gamma_prime, and its gamma_prime is the first half
// of this one.

// Last level (LOG_N = 1): two generators per side.
fn dory_setup_ok<G1: Group, G2: Group, GT: Pairing<G1, G2>, F: Scalar<G1, G2>>(
    instance hash1_l_vec: [GT; 1],
    instance hash1_r_vec: [GT; 1],
    instance hash2_l_vec: [GT; 1],
    instance hash2_r_vec: [GT; 1],
    instance gamma_pair_ipp_vec: [GT; 1],
    extra gamma1: [G1; 2],
    extra gamma2: [G2; 2],
    extra gamma1_prime: [G1; 1],
    extra gamma2_prime: [G2; 1],
) -> Bool {
    hash1_l_vec[0] == pair(gamma1[0], gamma2_prime[0])
        && hash1_r_vec[0] == pair(gamma1[1], gamma2_prime[0])
        && hash2_l_vec[0] == pair(gamma1_prime[0], gamma2[0])
        && hash2_r_vec[0] == pair(gamma1_prime[0], gamma2[1])
        && gamma_pair_ipp_vec[0] == pair(gamma1[0], gamma2[0]) + pair(gamma1[1], gamma2[1])
}

// Level LOG_N >= 2: check this level, then the remaining ones.
fn dory_setup_ok<
    G1: Group,
    G2: Group,
    GT: Pairing<G1, G2>,
    F: Scalar<G1, G2>,
    S: Size,
    LOG_N: 2..S + 1,
>(
    instance hash1_l_vec: [GT; LOG_N],
    instance hash1_r_vec: [GT; LOG_N],
    instance hash2_l_vec: [GT; LOG_N],
    instance hash2_r_vec: [GT; LOG_N],
    instance gamma_pair_ipp_vec: [GT; LOG_N],
    extra gamma1: [G1; 2 ^ LOG_N],
    extra gamma2: [G2; 2 ^ LOG_N],
    extra gamma1_prime: [G1; 2 ^ (LOG_N - 1)],
    extra gamma2_prime: [G2; 2 ^ (LOG_N - 1)],
) -> Bool {
    let gamma1_l = gamma1[0..2 ^ (LOG_N - 1)];
    let gamma1_r = gamma1[2 ^ (LOG_N - 1)..2 ^ LOG_N];
    let gamma2_l = gamma2[0..2 ^ (LOG_N - 1)];
    let gamma2_r = gamma2[2 ^ (LOG_N - 1)..2 ^ LOG_N];

    hash1_l_vec[0] == reduce(+, [pair(gamma1_l[i], gamma2_prime[i]) for i in 0..2 ^ (LOG_N - 1)])
        && hash1_r_vec[0]
            == reduce(+, [pair(gamma1_r[i], gamma2_prime[i]) for i in 0..2 ^ (LOG_N - 1)])
        && hash2_l_vec[0]
            == reduce(+, [pair(gamma1_prime[i], gamma2_l[i]) for i in 0..2 ^ (LOG_N - 1)])
        && hash2_r_vec[0]
            == reduce(+, [pair(gamma1_prime[i], gamma2_r[i]) for i in 0..2 ^ (LOG_N - 1)])
        && gamma_pair_ipp_vec[0] == reduce(+, [pair(gamma1[i], gamma2[i]) for i in 0..2 ^ LOG_N])
        && dory_setup_ok(
            hash1_l_vec[1..LOG_N],
            hash1_r_vec[1..LOG_N],
            hash2_l_vec[1..LOG_N],
            hash2_r_vec[1..LOG_N],
            gamma_pair_ipp_vec[1..LOG_N],
            gamma1_prime,
            gamma2_prime,
            gamma1_prime[0..2 ^ (LOG_N - 2)],
            gamma2_prime[0..2 ^ (LOG_N - 2)],
        )
}

// Wrapper Protocol for Dory
proto dory_eval<G1: Group, G2: Group, GT: Pairing<G1, G2>, F: Scalar<G1, G2>, S: Size, LOG_N: S>(
    // Inputs (from the top-level LOG_N)
    instance c1: GT,
    instance c2: GT,
    instance c3: GT,

    // Verifier key, derived from the generators (see dory_setup_ok)
    instance hash1_l_vec: [GT; LOG_N],
    instance hash1_r_vec: [GT; LOG_N],
    instance hash2_l_vec: [GT; LOG_N],
    instance hash2_r_vec: [GT; LOG_N],
    instance gamma_pair_ipp_vec: [GT; LOG_N],
    instance final_gamma1: G1,
    instance final_gamma2: G2,

    // Proving key: the public generators, read only by the prover
    extra gamma1: [G1; 2 ^ LOG_N],
    extra gamma2: [G2; 2 ^ LOG_N],
    extra gamma1_prime: [G1; 2 ^ (LOG_N - 1)],
    extra gamma2_prime: [G2; 2 ^ (LOG_N - 1)],

    // Prover's witness secrets
    witness u_vec: [G1; 2 ^ LOG_N],
    witness g_vec: [G2; 2 ^ LOG_N],
) where
    c1 == reduce(+, [pair(u_vec[i], g_vec[i]) for i in 0..2 ^ LOG_N])
        && c2 == reduce(+, [pair(u_vec[i], gamma2[i]) for i in 0..2 ^ LOG_N])
        && c3 == reduce(+, [pair(gamma1[i], g_vec[i]) for i in 0..2 ^ LOG_N])
        && dory_setup_ok(
            hash1_l_vec,
            hash1_r_vec,
            hash2_l_vec,
            hash2_r_vec,
            gamma_pair_ipp_vec,
            gamma1,
            gamma2,
            gamma1_prime,
            gamma2_prime,
        )
        // After the last reduction the generators are gamma_prime's first element.
        && final_gamma1 == gamma1_prime[0]
        && final_gamma2 == gamma2_prime[0]
{
    // Start the reduction proof
    dory_reduce(
        c1,
        c2,
        c3,
        hash1_l_vec,
        hash1_r_vec,
        hash2_l_vec,
        hash2_r_vec,
        gamma_pair_ipp_vec,
        final_gamma1,
        final_gamma2,
        gamma1,
        gamma2,
        gamma1_prime,
        gamma2_prime,
        u_vec,
        g_vec,
    )
}
