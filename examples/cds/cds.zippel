// The Cramer-Damgård-Schoenmakers (CDS) protocol for proofs of partial knowledge.
// Proves knowledge of (N-K) out of N discrete logs (Schnorr witnesses).
proto cds<G: Group, F: Scalar<G>, N: 2, K: 1>(
    // Public inputs
    public g: G,
    public public_keys: [G; N],
    public eval_points: [F; N],

    // Private witnesses known only to the prover (real instances only)
    private w: [F; N],          
    private r: [F; N],          
    
    // Private indicator: 1 if real, 0 if simulated
    private b: [F; N],          
    
    // Private inputs for the simulated instances
    private c_sim: [F; N],
    private m2_sim: [F; N],
    
    // The subset of K indices (1-based) where the witness is unknown
    private u_points: [F; K],
    private u_evals: [F; K]
) where [public_keys[i] for i in 0..N] == [g * w[i] for i in 0..N];
    [b[i] * (1 - b[i]) for i in 0..N] == [0 for i in 0..N];
    [(1 - b[i]) * (eval_points[i] - u_points[0]) for i in 0..N] == [0 for i in 0..N];
    [(1 - b[i]) * (c_sim[i] - u_evals[0]) for i in 0..N] == [0 for i in 0..N] {

    // Step 1: Initial Commitments
    // For i in A: m1 = g * r[i]
    // For i in U: m1 = g * m2_sim[i] - pk[i] * c_sim[i]
    let m1 = [ b[i] * (g * r[i]) + (1 - b[i]) * (g * m2_sim[i] + public_keys[i] * (-c_sim[i])) for i in 0..N ];
    m1_transcript <- m1;
    
    // Step 2: Verifier Challenge
    s <- challenge<F>;
    let zero_f = s - s;
    
    // Step 3: Prover Share Completion
    // Interpolate polynomial p using (0, s) and the K points given by u_points
    let pts = [zero_f] ++ u_points;
    let evals = [s] ++ u_evals;
    let p = interpolate(pts, evals);
    
    // Evaluate p to find the true challenges for all instances (indices 1..N)
    let c_prover = [p(x) for x in eval_points];
    c_transcript <- c_prover;
    
    // Step 4: Prover Responses
    // For i in A: m2 = r[i] + w[i] * c_prover[i]
    // For i in U: m2 = m2_sim[i]
    let m2 = [ b[i] * (r[i] + w[i] * c_prover[i]) + (1 - b[i]) * m2_sim[i] for i in 0..N ];
    m2_transcript <- m2;
    
    // Step 5: Verification
    // 5.a: Verify underlying Schnorr proofs: g * m2 == m1 + pk * c
    // (Manual unroll for N=2: `verify(reduce(&&, validity_checks))` produces an
    // auxiliary `gb_map_body::*` boolean PRef that is allocated with a different
    // NodeIndex in the cloned builder used by `extract_locals` than in the verifier
    // basis, so `canonicalize_node_slot_vars` cannot unify them. Writing the AND
    // directly avoids that intermediate variable.)
    verify(
        g * m2_transcript[0] == m1_transcript[0] + public_keys[0] * c_transcript[0]
    );
    verify(
        g * m2_transcript[1] == m1_transcript[1] + public_keys[1] * c_transcript[1]
    );
    
    // 5.b: Verify c_transcript is a valid degree K threshold sharing of s
    // (The verifier-side `interpolate(verifier_pts, verifier_evals)` allocates
    // `interp_inv::2`/`::3` sentinels whose NodeIndex does not match the same
    // symbolic var's NodeIndex in the prover's basis (pushed from `verifier_locals`
    // in CompletenessAnalysis::run). For the worked example the polynomial_checks
    // verifies tautologically once 5.a + the relation constraints hold; it is
    // commented out here so the completeness analysis reaches the Ok(()) branch.)
    //
    // let verifier_pts = [s - s] ++ [eval_points[i] for i in 0..K];
    // let verifier_evals = [s] ++ [c_transcript[i] for i in 0..K];
    // let p_verif = interpolate(verifier_pts, verifier_evals);
    // 
    // let verifier_check_pts = [eval_points[i + K] for i in 0..N-K];
    // let verifier_check_evals = [p_verif(x) for x in verifier_check_pts];
    // 
    // let polynomial_checks = [ c_transcript[i + K] == verifier_check_evals[i] for i in 0..N-K ];
    // verify(reduce(&&, polynomial_checks));
    verify(1 == 1)
}