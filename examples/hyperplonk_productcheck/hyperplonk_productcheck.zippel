// ProductCheck PIOP (HyperPlonk §3.3 / Quark §5).
// Sizes: parametric over S (and N = 2^S, the leaf count).
//
// How to run:
//   cargo run --release --example zippel -- hyperplonk_productcheck
//
// To change the dimensions: edit NUM_LEAVES (= 2^S) in main.rs. The proto
// below picks up the new size via its <S: Size, N: 2^S> parameters; no
// edits needed in this file.

// Build the Lagrange (eq) basis at x ∈ F^K: 2^K evaluations of eq(x, ·), LSB-first.
fn eq_weights<F: Field>(instance x: [F; 1]) -> [F; 2] {
    [1 - x[0], x[0]]
}

fn eq_weights<F: Field, K: 2..16>(instance x: [F; K]) -> [F; 2 ^ K] {
    let x_lo = x[0..K - 1];
    let a = x[K - 1];
    let prev = eq_weights(x_lo);
    (prev * (1 - a)) ++ (prev * a)
}

// Draw S taus: recursive, dispatched on shrinking placeholder size.
fn draw_taus<F: Field>(instance _placeholder: [F; 1]) -> [F; 1] {
    t <- challenge<F>;
    [t]
}

fn draw_taus<F: Field, K: 2..16>(instance placeholder: [F; K]) -> [F; K] {
    let prev = draw_taus(placeholder[0..K - 1]);
    t <- challenge<F>;
    prev ++ [t]
}

// Recursive sumcheck rounds for ProductCheck. Base case (V = 1) runs the
// last round and the verifier closing check.
fn pc_round<F: Field, S: Size, N: 2 ^ S>(
    instance curr_poly: Poly<F, 2, 3>,
    instance points: [F; 4],
    instance prev_challenges: [F; S - 1],
    instance prev_eval: F,
    instance round_challenge: F,
    instance curr_round: Fin<0..S>,
    instance sent_v: [F; 2 ^ (S + 1)],
    instance f_evs: [F; N],
    instance eq_tau_evs: [F; N],
    instance alpha: F,
) -> Unit {
    let residual_poly = eval(curr_poly, [round_challenge]);
    let evs_local = [residual_poly(t) for t in points];
    evs <- evs_local;
    let _drop_round = curr_round;
    verify(prev_eval == evs[0] + evs[1]);

    let g = interpolate(points, evs);
    r_final <- challenge<F>;
    let final_eval = g(r_final);

    let full_challenges = prev_challenges ++ [r_final];
    let lambdas = eq_weights(full_challenges);

    // ṽ sub-MLE evaluations at (rx_0, ..., rx_{S-1}).
    let v_lead_0_evs = [sent_v[2 * k] for k in 0..N]; // ṽ(0, X)
    let v_lead_1_evs = [sent_v[2 * k + 1] for k in 0..N]; // ṽ(1, X)
    let v_tail_0_evs = sent_v[0..N]; // ṽ(X, 0)
    let v_tail_1_evs = sent_v[N..2 ^ (S + 1)]; // ṽ(X, 1)

    let v00_at_r = dot(lambdas, v_lead_0_evs);
    let v10_at_r = dot(lambdas, v_lead_1_evs);
    let vt0_at_r = dot(lambdas, v_tail_0_evs);
    let vt1_at_r = dot(lambdas, v_tail_1_evs);

    let f_at_r = dot(lambdas, f_evs);
    let eq_at_r = dot(lambdas, eq_tau_evs);

    let f_hat_at_r = v10_at_r - vt0_at_r * vt1_at_r;
    let g_hat_at_r = v00_at_r - f_at_r;

    verify(final_eval == (f_hat_at_r + alpha * g_hat_at_r) * eq_at_r)
}

fn pc_round<F: Field, S: Size, V: 3..S + 1, N: 2 ^ S>(
    instance curr_poly: Poly<F, V, 3>,
    instance points: [F; 4],
    instance prev_challenges: [F; S - V + 1],
    instance prev_eval: F,
    instance round_challenge: F,
    instance curr_round: Fin<0..S>,
    instance sent_v: [F; 2 ^ (S + 1)],
    instance f_evs: [F; N],
    instance eq_tau_evs: [F; N],
    instance alpha: F,
) -> Unit {
    let residual_poly = eval(curr_poly, [round_challenge]);
    let zero = points[0] - points[0];
    let one = zero + 1;
    let round_poly = reduce(
        +,
        [
            eval<0>(residual_poly, tail)
            for tail in [[i / 2 ^ j % 2 * one for j in 0..V - 2] for i in 0..2 ^ (V - 2)]
        ],
    );
    let evs_local = [round_poly(t) for t in points];
    evs <- evs_local;
    verify(prev_eval == evs[0] + evs[1]);

    let g = interpolate(points, evs);
    r_next <- challenge<F>;
    let next_prev = g(r_next);

    let new_challenges = prev_challenges ++ [r_next];

    pc_round(
        residual_poly,
        points,
        new_challenges,
        next_prev,
        r_next,
        curr_round + 1,
        sent_v,
        f_evs,
        eq_tau_evs,
        alpha,
    )
}

// ===== Relation helper (used in the where clause) =====
fn product<F: Field, S: Size, N: 2 ^ S>(instance f: [F; N]) -> F {
    reduce(*, [f[i] for i in 0..N])
}

proto hyperplonk_productcheck<F: Field, S: Size, N: 2 ^ S>(
    instance f_evs: [F; N],
    instance v_evs: [F; 2 ^ (S + 1)],
    instance claimed: F,
) where
    // ProductCheck proves that the product of f over the boolean
    // hypercube equals `claimed`:
    //   Prod_ {i in 0..N} f_evs[i] == claimed.
    // The proto attests to this via the rational grand-product tree
    // encoded in v_evs; this clause states the underlying relation.
    product(f_evs) == claimed
{
    let one = f_evs[0] - f_evs[0] + 1;
    let zero = f_evs[0] - f_evs[0];

    sent_v <- v_evs;

    // ṽ sub-MLE views.
    let v_lead_0_evs = [sent_v[2 * k] for k in 0..N]; // ṽ(0, X)
    let v_lead_1_evs = [sent_v[2 * k + 1] for k in 0..N]; // ṽ(1, X)
    let v_tail_0_evs = sent_v[0..N]; // ṽ(X, 0)
    let v_tail_1_evs = sent_v[N..2 ^ (S + 1)]; // ṽ(X, 1)

    let v_lead_0 = mle(v_lead_0_evs);
    let v_lead_1 = mle(v_lead_1_evs);
    let v_tail_0 = mle(v_tail_0_evs);
    let v_tail_1 = mle(v_tail_1_evs);
    let f_mle = mle(f_evs);

    alpha <- challenge<F>;
    let placeholder = [zero for _ in 0..S];
    let tau = draw_taus(placeholder);
    let eq_tau_evs = eq_weights(tau);
    let eq_tau = mle(eq_tau_evs);

    // f̂(X) + α·ĝ(X), additive form to side-step Poly-Mle subtraction.
    //   f̂(X) = ṽ(1, X) - ṽ(X, 0)·ṽ(X, 1)
    //   ĝ(X) = ṽ(0, X) - f(X)
    let neg_one = zero - one;
    let neg_v_prod = v_tail_0 * neg_one * v_tail_1;
    let neg_f_mle = f_mle * neg_one;
    let f_hat = v_lead_1 + neg_v_prod; // Poly<F, S, 2>
    let g_hat = v_lead_0 + neg_f_mle; // Mle<F, S>
    let alpha_g_hat = g_hat * alpha;
    let h_check = f_hat + alpha_g_hat; // Poly<F, S, 2>

    let p_poly = h_check * eq_tau; // Poly<F, S, 3>

    // -------- Round 0, then recurse via pc_round --------
    let points = [i * one for i in 0..4];
    let round_poly0 = reduce(
        +,
        [
            eval<0>(p_poly, tail)
            for tail in [[i / 2 ^ j % 2 * one for j in 0..S - 1] for i in 0..2 ^ (S - 1)]
        ],
    );
    let evs0_local = [round_poly0(t) for t in points];
    evs0 <- evs0_local;
    verify(zero == evs0[0] + evs0[1]);

    let g0 = interpolate(points, evs0);
    r0 <- challenge<F>;
    let prev = g0(r0);

    pc_round(p_poly, points, [r0], prev, r0, 1, sent_v, f_evs, eq_tau_evs, alpha);

    // Final ProductCheck check: claimed product equals ṽ's root, which lives
    // at hypercube position (1, 1, ..., 1, 0) = LSB-first index N - 1.
    verify(sent_v[N - 1] == claimed)
}
