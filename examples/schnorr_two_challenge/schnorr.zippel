proto schnorr<G: Group, F: Scalar<G>>(private x: F, public g: G, public h: G) where h == g*x {
    let r1 = random<F>;
    u1 <- g * r1;

    let r2 = random<F>;
    u2 <- g * r2;

    c1 <- challenge<F*>;
    c2 <- challenge<F*>;

    z1 <- r1 + x * c1;
    z2 <- r2 + r1 * c2 + x * (c1 * c2);

    verify(
        g*z1 == u1 + h*c1 &&
        g*z2 == u2 + u1*c2 + h*(c1*c2)
    )
}