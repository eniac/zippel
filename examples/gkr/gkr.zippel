// ---- Sumcheck for N=2 ----
fn gkr_sumcheck_round_2<F: Field>(
    public orig_poly: Poly<F, 2, 2>,
    public curr_poly: Poly<F, 2, 2>,
    public points: [F; 3],
    public challenges: [F; 0],
    public prev_eval: F,
    public challenge: F,
    public curr_round: Fin<2>
) -> [F; 2] {
    let cfg = {| poly: curr_poly, num_variables: 2, max_degree: 2, round: curr_round, challenge: challenge |};
    let out = marginalize(cfg);
    let pi = out.next_poly;

    evs <- out.evaluations;
    verify(prev_eval == evs[0] + evs[1]);

    let g = interpolate(points, evs);
    r_next <- challenge<F>;
    let next_prev_vec = eval(g, [r_next]);
    let next_prev = next_prev_vec[0];

    let next_challenges = challenges ++ [r_next];
    gkr_sumcheck_round_2_base(orig_poly, pi, points, next_challenges, next_prev, r_next, curr_round + 1)
}

fn gkr_sumcheck_round_2_base<F: Field>(
    public orig_poly: Poly<F, 2, 2>,
    public curr_poly: Poly<F, 1, 2>,
    public points: [F; 3],
    public challenges: [F; 1],
    public prev_eval: F,
    public challenge: F,
    public curr_round: Fin<2>
) -> [F; 2] {
    let cfg = {| poly: curr_poly, num_variables: 2, max_degree: 2, round: curr_round, challenge: challenge |};
    let out = marginalize(cfg);
    evs <- out.evaluations;
    verify(prev_eval == evs[0] + evs[1]);

    let g = interpolate(points, evs);
    r_final <- challenge<F>;
    let full_challenges = challenges ++ [r_final];
    let from_round_vec = eval(g, [r_final]);
    let from_round = from_round_vec[0];
    let from_orig = eval(orig_poly, full_challenges);

    verify(from_round == from_orig);
    full_challenges
}

fn gkr_sumcheck_2<F: Field>(
    public claimed_sum: F,
    public poly: Poly<F, 2, 2>
) -> [F; 2] {
    let zero = claimed_sum - claimed_sum;
    let cfg0 = {| poly: poly, num_variables: 2, max_degree: 2, round: 0, challenge: zero |};
    let out0 = marginalize(cfg0);
    evs0 <- out0.evaluations;
    verify(claimed_sum == evs0[0] + evs0[1]);

    r1 <- challenge<F>;
    let points = [i for i in 0..3];
    let g = interpolate(points, evs0);
    let prev_vec = eval(g, [r1]);
    let prev = prev_vec[0];
    
    gkr_sumcheck_round_2_base(poly, out0.next_poly, points, [r1], prev, r1, 1)
}

// ---- Sumcheck for N=4 ----
fn gkr_sumcheck_round_4<F: Field, V: 2..4>(
    public orig_poly: Poly<F, 4, 2>,
    public curr_poly: Poly<F, V, 2>,
    public points: [F; 3],
    public challenges: [F; 4 - V],
    public prev_eval: F,
    public challenge: F,
    public curr_round: Fin<4>
) -> [F; 4] {
    let cfg = {| poly: curr_poly, num_variables: 4, max_degree: 2, round: curr_round, challenge: challenge |};
    let out = marginalize(cfg);
    let pi = out.next_poly;

    evs <- out.evaluations;
    verify(prev_eval == evs[0] + evs[1]);

    let g = interpolate(points, evs);
    r_next <- challenge<F>;
    let next_prev_vec = eval(g, [r_next]);
    let next_prev = next_prev_vec[0];

    let next_challenges = challenges ++ [r_next];
    gkr_sumcheck_round_4(orig_poly, pi, points, next_challenges, next_prev, r_next, curr_round + 1)
}

fn gkr_sumcheck_round_4<F: Field>(
    public orig_poly: Poly<F, 4, 2>,
    public curr_poly: Poly<F, 1, 2>,
    public points: [F; 3],
    public challenges: [F; 3],
    public prev_eval: F,
    public challenge: F,
    public curr_round: Fin<4>
) -> [F; 4] {
    let cfg = {| poly: curr_poly, num_variables: 4, max_degree: 2, round: curr_round, challenge: challenge |};
    let out = marginalize(cfg);
    evs <- out.evaluations;
    verify(prev_eval == evs[0] + evs[1]);

    let g = interpolate(points, evs);
    r_final <- challenge<F>;
    let full_challenges = challenges ++ [r_final];
    let from_round_vec = eval(g, [r_final]);
    let from_round = from_round_vec[0];
    let from_orig = eval(orig_poly, full_challenges);

    verify(from_round == from_orig);
    full_challenges
}

fn gkr_sumcheck_4<F: Field>(
    public claimed_sum: F,
    public poly: Poly<F, 4, 2>
) -> [F; 4] {
    let zero = claimed_sum - claimed_sum;
    let cfg0 = {| poly: poly, num_variables: 4, max_degree: 2, round: 0, challenge: zero |};
    let out0 = marginalize(cfg0);
    evs0 <- out0.evaluations;
    verify(claimed_sum == evs0[0] + evs0[1]);

    r1 <- challenge<F>;
    let points = [i for i in 0..3];
    let g = interpolate(points, evs0);
    let prev_vec = eval(g, [r1]);
    let prev = prev_vec[0];
    
    gkr_sumcheck_round_4(poly, out0.next_poly, points, [r1], prev, r1, 1)
}

fn line_reduce<F: Field, N: 1>(
    public r_b: [F; N],
    public r_c: [F; N],
    public v_b: F,
    public v_c: F
) -> { r_star: [F; N], v_star: F } {
    let q = interpolate([0, 1], [v_b, v_c]);
    
    r <- challenge<F>;
    let q_r_vec = eval(q, [r]);
    
    let r_star = [ r_b[i] + r * (r_c[i] - r_b[i]) for i in 0..N ];
    
    {| r_star: r_star, v_star: q_r_vec[0] |}
}

// Specific Example for Layer 0 -> Layer 1
// Output layer (Layer 0) has 2 gates (1 bit).
// Layer 1 has 2 gates (1 bit).
// So sumcheck is over 2 variables (1 for b, 1 for c).
fn verify_layer_0<F: Field>(
    public r_0: [F; 1],
    public v_0: F,
    public add_0: Mle<F, 3>,
    public mul_0: Mle<F, 3>,
    public g_0: Poly<F, 2, 2>,
    public v_1_mle: Mle<F, 1>
) -> { r_b: [F; 1], r_c: [F; 1], v_b: F, v_c: F } {
    let r_bc = gkr_sumcheck_2(v_0, g_0);
    let r_b = [r_bc[0]];
    let r_c = [r_bc[1]];
    
    let g_eval = eval(g_0, r_bc);
    
    let add_eval = eval(add_0, r_0 ++ r_bc);
    let mul_eval = eval(mul_0, r_0 ++ r_bc);
    
    let vb_vec = eval(v_1_mle, r_b);
    let vc_vec = eval(v_1_mle, r_c);
    let vb = vb_vec[0];
    let vc = vc_vec[0];
    
    verify(g_eval == add_eval * (vb + vc) + mul_eval * (vb * vc));
    
    {| r_b: r_b, r_c: r_c, v_b: vb, v_c: vc |}
}

// Specific Example for Layer 1 -> Layer 2
// Layer 1 has 2 gates (1 bit).
// Layer 2 has 4 gates (2 bits).
// So sumcheck is over 4 variables (2 for b, 2 for c).
fn verify_layer_1<F: Field>(
    public r_1: [F; 1],
    public v_1: F,
    public add_1: Mle<F, 5>,
    public mul_1: Mle<F, 5>,
    public g_1: Poly<F, 4, 2>,
    public v_2_mle: Mle<F, 2>
) -> Bool {
    let r_bc = gkr_sumcheck_4(v_1, g_1);
    let r_b = [r_bc[0], r_bc[1]];
    let r_c = [r_bc[2], r_bc[3]];
    
    let g_eval = eval(g_1, r_bc);
    
    let add_eval = eval(add_1, r_1 ++ r_bc);
    let mul_eval = eval(mul_1, r_1 ++ r_bc);
    
    let vb = eval(v_2_mle, r_b);
    let vc = eval(v_2_mle, r_c);
    
    verify(g_eval == add_eval * (vb + vc) + mul_eval * (vb * vc));
    true
}

// Main GKR protocol for our 2-layer circuit
// L0: 2 gates. L1: 2 gates. L2: 4 gates.
proto gkr<F: Field>(
    public output_point: [F; 1],
    public output_val: F,
    public add_0: Mle<F, 3>,
    public mul_0: Mle<F, 3>,
    public g_0: Poly<F, 2, 2>,
    public v_1_mle: Mle<F, 1>,
    
    public r_1: [F; 1],
    public v_1: F,
    public add_1: Mle<F, 5>,
    public mul_1: Mle<F, 5>,
    public g_1: Poly<F, 4, 2>,
    public v_2_mle: Mle<F, 2>
) where true {
    // 1. Verify Layer 0
    let l0_out = verify_layer_0(output_point, output_val, add_0, mul_0, g_0, v_1_mle);
    
    // 2. Line reduce from (r_b, r_c) to r_star
    let lr_out = line_reduce(l0_out.r_b, l0_out.r_c, l0_out.v_b, l0_out.v_c);
    
    // 3. Verify Layer 1
    // Note: We use the statically provided r_1 and v_1 for testing since g_1 is static.
    // In a full implementation, we would use lr_out.r_star and lr_out.v_star.
    verify(verify_layer_1(r_1, v_1, add_1, mul_1, g_1, v_2_mle))
}
