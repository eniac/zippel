// DeKART: ZK range proofs from univariate polynomials
// From: https://eprint.iacr.org/2025/1159 and https://alinush.github.io/dekart
//
// Follows Aptos' `dekart_univariate_v2` (aptos-dkg/src/range_proofs) step by
// step: same statement, same prover messages, same challenges in the same
// order, same verifier checks. Step numbers below are the upstream ones.
//
// Like upstream, the prover commits in the Lagrange basis where the values
// are small (hat_c from com_f, digit polynomials from their 0/1 evaluations),
// so `dot` hits arkworks' small-scalar MSM path. Commitments are the same
// group elements as in the monomial basis; only the prover's arithmetic
// differs.

proto dekart<
    g1: Group,
    g2: Group,
    gt: Pairing<g1, g2>,
    f: Scalar<g1, g2>,
    n: Size,
    b: Size,
    l_chunk: Size,
    h_deg: (b - 1) * n,
>(
    // Witness: f(ω^0) = 0, f(ω^i) = z_i; chunks_bits[j][i] is the j-th radix-b digit of z_{i+1}
    witness f_evals: [f; n + 1],
    witness chunks_bits: [[f; n]; l_chunk],
    witness rho: f,

    // Statement: hiding KZG commitment to f
    instance com_f: g1,

    // Public parameters
    instance b_pow: [f; l_chunk],
    instance gen_g1: g1,
    instance gen_g2: g2,
    instance srs_g2_tau: g2,
    instance srs_g2_xi: g2,
    instance xi_g1: g1,
    instance s0_commit: g1,
    extra srs_g1_lagr: [g1; n + 1], // [ℓ_i(τ)]_1 over the size-(n + 1) domain
    extra srs_g1_h: [g1; h_deg + 1], // [τ^i]_1
    extra v_star: [f; n + 1], // coefficients of V*(X) = 1 + X + ... + X^n
) where
    // Trusted setup: sample the trapdoors (τ, ξ) and derive the SRS.
    let tau = random<f>;
    let xi = random<f>;
    // ℓ_i(τ) = IFFT(1, τ, ..., τ^n)_i, as in upstream's `lagrange_basis`.
    let lagr = coef(interpolate([tau ^ k for k in 0..n + 1]));
    reduce(&&, srs_g1_h == [gen_g1 * tau ^ i for i in 0..h_deg + 1])
        && reduce(&&, srs_g1_lagr == [gen_g1 * lagr[i] for i in 0..n + 1])
        && srs_g2_tau == gen_g2 * tau
        && xi_g1 == gen_g1 * xi
        && srs_g2_xi == gen_g2 * xi
        // s0_commit commits to the Lagrange polynomial L_0.
        && s0_commit == srs_g1_lagr[0]
        && reduce(&&, v_star == [1 for _ in 0..n + 1])
        // Statement: com_f commits to f with hiding randomness rho.
        && com_f == dot(f_evals, srs_g1_lagr) + xi_g1 * rho
        // Range: every digit lies in [0, b).
        && reduce(
            &&,
            [
                let chunk_j = chunks_bits[j];
                reduce(
                    &&,
                    [reduce(*, [chunk_j[i] - d for d in 0..b]) for i in 0..n] == [0 for _ in 0..n],
                )
                for j in 0..l_chunk
            ],
        )
        && f_evals[0] == 0
        // Decomposition: z_i = Σ_j b^j · digit_j(z_i).
        && reduce(
            &&,
            f_evals[1..n + 1]
                == [
                    reduce(
                        +,
                        [
                            let chunk_j = chunks_bits[j];
                            chunk_j[i] * b_pow[j]
                            for j in 0..l_chunk
                        ],
                    )
                    for i in 0..n
                ],
        )
{
    // Step 2: re-randomise f(ω^0) and the hiding randomness
    let r = random<f>;
    let delta_rho = random<f>;
    let f_hat = interpolate([r] ++ f_evals[1..n + 1]);
    hat_c <- com_f + xi_g1 * delta_rho + s0_commit * r;

    // Step 3: Okamoto PoK of (r, delta_rho) s.t. hat_c - com_f = s0_commit * r + xi_g1 * delta_rho
    let pok_r1 = random<f>;
    let pok_r2 = random<f>;
    pok_a <- s0_commit * pok_r1 + xi_g1 * pok_r2;
    pok_c <- challenge<f>;
    pok_z1 <- pok_r1 + pok_c * r;
    pok_z2 <- pok_r2 + pok_c * delta_rho;

    // Step 4: hiding commitments to the digit polynomials f_j, with f_j(ω^0) = r_j random
    let rs = [random<f> for _ in 0..l_chunk];
    let rhos = [random<f> for _ in 0..l_chunk];
    let f_j_evals = [[rs[j]] ++ chunks_bits[j] for j in 0..l_chunk];
    let f_j_vec = [interpolate(f_j_evals[j]) for j in 0..l_chunk];
    com_chunks <- [dot(f_j_evals[j], srs_g1_lagr) + xi_g1 * rhos[j] for j in 0..l_chunk];

    // Step 6: ell + 1 independent challenges
    betas <- [challenge<f> for _ in 0..l_chunk];
    beta <- challenge<f>;

    // h = (beta * (f_hat - \sum b^j f_j) + \sum beta_j \prod_d (f_j - d)) / V*,
    // V*(X) = (X^{n+1} - 1) / (X - 1) vanishes on ω^1..ω^n
    let h_num = (f_hat - reduce(+, [f_j_vec[j] * b_pow[j] for j in 0..l_chunk])) * beta
        + reduce(+, [reduce(*, [f_j_vec[j] - d for d in 0..b]) * betas[j] for j in 0..l_chunk]);
    let h = h_num / poly(v_star);

    // Step 7: commit to h
    // `h`'s declared bound is the conservative static capacity of the
    // quotient type (the dividend's bound). The meaningful coefficients stop
    // at h_deg: V* is monic of exact degree n, so every higher slot is zero.
    let h_coeffs_full = coef(h);
    let h_coeffs = h_coeffs_full[0..h_deg + 1];
    let rho_h = random<f>;
    com_h <- dot(h_coeffs, srs_g1_h) + xi_g1 * rho_h;

    // Step 8: evaluation point
    gamma <- challenge<f>;

    // Step 9: evaluations at gamma, then ell + 2 batching challenges
    a <- f_hat(gamma);
    a_h <- h(gamma);
    a_js <- [
        let pj = f_j_vec[j];
        pj(gamma)
        for j in 0..l_chunk
    ];
    mus <- [challenge<f> for _ in 0..l_chunk];
    mu_h <- challenge<f>;
    mu <- challenge<f>;

    // Step 10: hiding KZG opening of u = mu f_hat + mu_h h + \sum mu_j f_j at gamma
    let u = f_hat * mu + h * mu_h + reduce(+, [f_j_vec[j] * mus[j] for j in 0..l_chunk]);
    let a_u = a * mu + a_h * mu_h + reduce(+, [a_js[j] * mus[j] for j in 0..l_chunk]);
    let s = random<f>;
    let q_u = (u - a_u) / poly([-gamma, 1]);
    let rho_u = mu * (rho + delta_rho)
        + mu_h * rho_h
        + reduce(+, [rhos[j] * mus[j] for j in 0..l_chunk]);
    // The opening divisor X - gamma has exact degree 1, so q_u's meaningful
    // coefficients stop at h_deg - 1 (h_deg slots).
    let q_u_coeffs = coef(q_u);
    let q_u_coeffs_truncated = q_u_coeffs[0..h_deg];
    pi_1 <- xi_g1 * s + dot(q_u_coeffs_truncated, srs_g1_h[0..h_deg]);
    pi_2 <- gen_g1 * rho_u - (srs_g1_h[1] - gen_g1 * gamma) * s;

    // VERIFICATION
    // Verifier step 3: PoK
    verify(s0_commit * pok_z1 + xi_g1 * pok_z2 == pok_a + (hat_c - com_f) * pok_c);

    // Verifier step 11: quotient identity at gamma
    // V*(gamma) = (gamma^{n+1} - 1) / (gamma - 1); the one-element range binds the exponent n + 1
    let gamma_pow_vec = [gamma ^ i for i in n + 1..n + 2];
    let gamma_pow = gamma_pow_vec[0];
    let v_s_at_gamma = (gamma_pow - 1) / (gamma - 1);
    let sum_betas = reduce(
        +,
        [betas[j] * reduce(*, [a_js[j] - d for d in 0..b]) for j in 0..l_chunk],
    );
    let diff_val = a - reduce(+, [a_js[j] * b_pow[j] for j in 0..l_chunk]);
    verify(a_h * v_s_at_gamma == beta * diff_val + sum_betas);

    // Verifier step 10: batched hiding-KZG check on U = mu hat_c + mu_h com_h + \sum mu_j C_j:
    // e(U - a_u g1, g2) + e(-pi_1, tau_2 - gamma g2) + e(-pi_2, xi_2) == 0_GT as ONE
    // multi-pairing (dot(VecG1, VecG2) -> GT): one final exponentiation, like upstream.
    let verif_u = hat_c * mu
        + com_h * mu_h
        + reduce(+, [com_chunks[j] * mus[j] for j in 0..l_chunk]);
    let zero_g1 = gen_g1 - gen_g1;
    let pairing = dot(
        [verif_u - gen_g1 * a_u, zero_g1 - pi_1, zero_g1 - pi_2],
        [gen_g2, srs_g2_tau - gen_g2 * gamma, srs_g2_xi],
    );
    verify(pairing == pairing - pairing)
}
