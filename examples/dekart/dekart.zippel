// DeKART: ZK range proofs from univariate polynomials
// From: https://eprint.iacr.org/2025/1159 and https://alinush.github.io/dekart
//
// Follows Aptos' `dekart_univariate_v2` (aptos-dkg/src/range_proofs) step by
// step: same statement, same prover messages, same challenges in the same
// order, same verifier checks. Step numbers below are the upstream ones.
//
// Like upstream, the prover commits in the Lagrange basis where the values
// are small (Ĉ from com_f, digit polynomials from their 0/1 evaluations), so
// `dot` hits arkworks' small-scalar MSM path. Commitments are the same group
// elements as in the monomial basis; only the prover's arithmetic differs.

proto dekart<
    g1: Group,
    g2: Group,
    gt: Pairing<g1, g2>,
    f: Scalar<g1, g2>,
    n: Size,
    b: Size,
    l_chunk: Size,
    h_deg: (b-1)*n
>(
    // Witness: f(ω^0) = 0, f(ω^i) = z_i; chunks_bits[j][i] = j-th radix-b digit of z_i
    private f_evals: [f; n+1],
    private chunks_bits: [[f; n]; l_chunk],
    private rho: f,

    // Statement: hiding KZG commitment to f
    public com_f: g1,

    // Public parameters
    public b_vals: [f; b],
    public b_pow: [f; l_chunk],
    public f_one: f,
    public gen_g1: g1,
    public gen_g2: g2,
    public srs_g2_tau: g2,
    public srs_g2_xi: g2,
    public xi_g1: g1,
    public s0_commit: g1,
    private srs_g1_lagr: [g1; n+1],   // [ℓ_i(τ)]_1 over the size-(n+1) domain; s0_commit = srs_g1_lagr[0]
    private srs_g1_h: [g1; h_deg+1],  // [τ^i]_1
    private v_star: [f; n+1]          // coefficients of V*(X) = 1 + X + ... + X^n
) where srs_g1_h[0] == gen_g1 && srs_g1_lagr[0] == s0_commit {

    // Step 2: re-randomise f(ω^0) and the hiding randomness
    let r = random<f>;
    let delta_rho = random<f>;
    let f_hat = interpolate([r] ++ f_evals[1..n+1]);
    hat_c <- com_f + xi_g1 * delta_rho + s0_commit * r;

    // Step 3: Okamoto PoK of (r, delta_rho) s.t. hat_c - com_f = s0_commit * r + xi_g1 * delta_rho
    let pok_r1 = random<f>;
    let pok_r2 = random<f>;
    pok_a <- s0_commit * pok_r1 + xi_g1 * pok_r2;
    pok_c <- challenge<f>;
    pok_z1 <- pok_r1 + pok_c * r;
    pok_z2 <- pok_r2 + pok_c * delta_rho;

    // Step 4: hiding commitments to the digit polynomials f_j, with f_j(ω^0) = r_j random
    let rs = [random<f> for j in 0..l_chunk];
    let rhos = [random<f> for j in 0..l_chunk];
    let f_j_evals = [ [rs[j]] ++ chunks_bits[j] for j in 0..l_chunk ];
    let f_j_vec = [ interpolate(f_j_evals[j]) for j in 0..l_chunk ];
    com_chunks <- [ dot(f_j_evals[j], srs_g1_lagr) + xi_g1 * rhos[j] for j in 0..l_chunk ];

    // Step 6: ell + 1 independent challenges
    betas <- [ challenge<f> for j in 0..l_chunk ];
    beta <- challenge<f>;

    // h = (beta * (f_hat - \sum b^j f_j) + \sum beta_j \prod_d (f_j - d)) / V*,
    // V*(X) = (X^{n+1} - 1) / (X - 1) vanishes on ω^1..ω^n
    let h_num = (f_hat - reduce(+, [ f_j_vec[j] * b_pow[j] for j in 0..l_chunk ])) * beta
        + reduce(+, [ reduce(*, [f_j_vec[j] - d for d in b_vals]) * betas[j] for j in 0..l_chunk ]);
    let h = h_num / poly(v_star);

    // Step 7: commit to h
    let rho_h = random<f>;
    com_h <- dot(coef(h), srs_g1_h) + xi_g1 * rho_h;

    // Step 8: evaluation point
    gamma <- challenge<f>;

    // Step 9: evaluations at gamma, then ell + 2 batching challenges
    a <- (let v = eval(f_hat, [gamma]); v[0]);
    a_h <- (let v = eval(h, [gamma]); v[0]);
    a_js <- [ (let v = eval(f_j_vec[j], [gamma]); v[0]) for j in 0..l_chunk ];
    mus <- [ challenge<f> for j in 0..l_chunk ];
    mu_h <- challenge<f>;
    mu <- challenge<f>;

    // Step 10: hiding KZG opening of u = mu f_hat + mu_h h + \sum mu_j f_j at gamma
    let u = f_hat * mu + h * mu_h + reduce(+, [ f_j_vec[j] * mus[j] for j in 0..l_chunk ]);
    let a_u = a * mu + a_h * mu_h + reduce(+, [ a_js[j] * mus[j] for j in 0..l_chunk ]);
    let s = random<f>;
    let q_u = (u - a_u) / poly([-gamma, f_one]);
    let rho_u = mu * (rho + delta_rho) + mu_h * rho_h + reduce(+, [ rhos[j] * mus[j] for j in 0..l_chunk ]);
    pi_1 <- xi_g1 * s + dot(coef(q_u), srs_g1_h[0..h_deg]);
    pi_2 <- gen_g1 * rho_u - (srs_g1_h[1] - gen_g1 * gamma) * s;

    // VERIFICATION
    // Verifier step 3: PoK
    verify(s0_commit * pok_z1 + xi_g1 * pok_z2 == pok_a + (hat_c - com_f) * pok_c);

    // Verifier step 11: quotient identity at gamma
    // V*(gamma) = (gamma^{n+1} - 1) / (gamma - 1); the one-element range binds the exponent n+1
    let gamma_pow = (let v = [gamma ^ i for i in n+1..n+2]; v[0]);
    let v_s_at_gamma = (gamma_pow - f_one) / (gamma - f_one);
    let sum_betas = reduce(+, [ betas[j] * reduce(*, [a_js[j] - d for d in b_vals]) for j in 0..l_chunk ]);
    let diff_val = a - reduce(+, [ a_js[j] * b_pow[j] for j in 0..l_chunk ]);
    verify(a_h * v_s_at_gamma == beta * diff_val + sum_betas);

    // Verifier step 10: batched hiding-KZG pairing check on U = mu hat_c + mu_h com_h + \sum mu_j C_j
    let verif_u = hat_c * mu + com_h * mu_h + reduce(+, [ com_chunks[j] * mus[j] for j in 0..l_chunk ]);
    // e(U - a_u g1, g2) + e(-pi_1, tau_2 - gamma g2) + e(-pi_2, xi_2) == 0_GT as ONE
    // multi-pairing (dot(VecG1, VecG2) -> GT): one final exponentiation, like upstream.
    let zero_g1 = gen_g1 - gen_g1;
    let pairing = dot([verif_u - gen_g1 * a_u, zero_g1 - pi_1, zero_g1 - pi_2],
                      [gen_g2, srs_g2_tau - gen_g2 * gamma, srs_g2_xi]);
    verify(pairing == pairing - pairing)
}
