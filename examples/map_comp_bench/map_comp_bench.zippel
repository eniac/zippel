// Map comprehension benchmark with parameterized size N.
//
// Exercises three map comprehension patterns commonly found in ZK protocols:
//   1. Random sampling:       [random<F> for i in 0..N]
//   2. Element-wise indexed:  [x_vec[i] * r_vec[i] for i in 0..N]
//   3. Affine combination:    [x_vec[i] * c + r_vec[i] for i in 0..N]
//
// Run with different sizes to measure scaling behavior.

proto map_comp_bench<G: Group, F: Scalar<G>, S: Size, N: S>(
    public g_vec: [G; N],
    public x_vec: [F; N]
) where (g_vec == g_vec) {
    // Pattern 1: Random sampling via map comprehension
    let r_vec = [random<F> for i in 0..N];

    // Built-in vector multiply + reduce (baseline comparison)
    let gr = g_vec * r_vec;
    comm <- reduce(+, gr);

    // Pattern 2: Element-wise comprehension with indexed access
    let products = [x_vec[i] * r_vec[i] for i in 0..N];
    d <- reduce(+, products);

    // Challenge from transcript
    c <- challenge<F>;

    // Pattern 3: Affine comprehension (challenge * witness + randomness)
    let resp = [x_vec[i] * c + r_vec[i] for i in 0..N];
    let resp_sum = reduce(+, resp);

    verify(resp_sum == resp_sum)
}
