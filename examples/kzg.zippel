proto kzg<G1: Group, G2: Group, GT: Pairing<G1, G2>, F: Scalar<G1, G2>, N: 10>
        (private p: Uni<F, 10>, private z: F, public y: F, private s: F, private ss: [F; N],
        public g: G1, public h: G2)
        where p(z) == y && [(ss[i] == s^i) for i in 0..N] {

        // Commitment [c: G1]
        c <- (p . ss) * g;

        // q(X) = p(X) - y / X - y
        let q = (p - y) / coef([-y, 1]); // p(X) = X - y

        // Proof [pi: G1]
        pi <- (q . ss[0..9]) * g;

        verify(pair(pi, (s - z) * h) == pair(c - g * y, h))
}
