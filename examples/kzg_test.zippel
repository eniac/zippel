proto kzg<G1: Group, G2: Group, GT: Pairing<G1, G2>, F: Scalar<G1, G2>, N: 4>
        (private p: [F; N], public z: F, public y: F, public ss: [G1; N],
        public g: G1, public h: G2, h_val: G2)
        where p == p {
        //p(z) == y && ss[0] == g && [(pair(ss[i], h) == pair(ss[i-1], s)) for i in 1..N] {
        
        let p_val = poly(p);
        c <- p . ss;
        // let c = p . ss;

        let q_val = (p_val - y) / poly([-z, 1]);

        let pi_val = coef(q_val);
        let test = ss[0..N-1];
        pi <- pi_val . test;


        let lhs = pair(pi, (h_val) - (h * z));
        let rhs = pair(c - y * g, h);
        verify(lhs == rhs)

}