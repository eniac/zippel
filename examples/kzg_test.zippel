proto kzg<G1: Group, G2: Group, GT: Pairing<G1, G2>, F: Scalar<G1, G2>, N: 2>
        (public p: [F; N], public z: F, public y: F, public s: F, public ss: [G1; N],
        public g: G1, public h: G2, public tau: F)
        where p == p {
        //p(z) == y && ss[0] == g && [(pair(ss[i], h) == pair(ss[i-1], s)) for i in 1..N] {
        
        let p_val = poly(p);
        let c_temp = eval(p_val, [tau]) * g; 
        let c = c_temp[0];
        
        let q_val = (p_val - y) / poly([-z, 1]);

        let pi_val = eval(q_val, [tau]) * g;
        let pi = pi_val[0];


        let lhs = pair(pi, (tau - z) * h);
        let rhs = pair(c - y * g, h);
        verify(lhs == rhs)
        // verify(p_val == p_val)
        // verify(pair(pi, tau - z*h) == pair(c - g * y, h))

}