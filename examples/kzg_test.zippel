proto kzg<G1: Group, G2: Group, GT: Pairing<G1, G2>, F: Scalar<G1, G2>, N: 2>
        (private p: [F; N], public z: F, public y: F, public ss: [G1; N],
        public g: G1, public h: G2, h_val: G2)
        where p == p {
        
        let p_val = poly(p);
        c <- dot(p, ss);

        let q_val = (p_val - y) / poly([-z, 1]);

        let pi_val = coef(q_val);
        let test = ss[0..N-1];
        pi <- dot(pi_val, test);


        let lhs = pair(pi, (h_val) - (h * z));
        let rhs = pair(c - y * g, h);
        verify(lhs == rhs)

}