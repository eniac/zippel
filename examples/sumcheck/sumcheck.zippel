fn sumcheck_round<F: Field, V: 2..10, MAX_DEGREE_CONST: 1..32>(
    public curr_poly: Poly<F, V, MAX_DEGREE_CONST>,
    public num_variables: Fin<32>,
    public max_degree: Fin<32>,
    public rounds_left: [Fin<32>; V]
) -> Bool {
    ri <- challenge<F>;
    let cfg = {| poly: curr_poly, num_variables: num_variables, max_degree: max_degree,
                 round: rounds_left[0], challenge: ri |};
    let out = marginalize(cfg);
    pi <- out.next_poly;

    // Check curr_poly[ri] == pi(0) + pi(1) using only next_poly path.
    let curr_at_ri = eval(curr_poly, [ri]);
    let pi_at_0 = eval(pi, [0]);
    let pi_at_1 = eval(pi, [1]);
    verify(curr_at_ri[0] == pi_at_0[0] + pi_at_1[0]);

    sumcheck_round(pi, num_variables, max_degree, rounds_left[1..V])
}

// Base recursion stop: one round left, no recursive call.
fn sumcheck_round<F: Field, MAX_DEGREE_CONST: 1..32>(
    public curr_poly: Poly<F, 1, MAX_DEGREE_CONST>,
    public num_variables: Fin<32>,
    public max_degree: Fin<32>,
    public rounds_left: [Fin<32>; 1]
) -> Bool {
    ri <- challenge<F>;
    let cfg = {| poly: curr_poly, num_variables: num_variables, max_degree: max_degree,
                 round: rounds_left[0], challenge: ri |};
    out <- marginalize(cfg);
    p_final <- out.next_poly;
    let curr_at_ri = eval(curr_poly, [ri]);
    curr_at_ri[0] == curr_at_ri[0]
}

// Round 1 is in the protocol body.
proto sumcheck<F: Field, NUM_VARS_CONST: 2..10, MAX_DEGREE_CONST: 1..32>(
    public claimed_sum: F,
    public poly: Poly<F, NUM_VARS_CONST, MAX_DEGREE_CONST>,
    public num_variables: Fin<32>,
    public max_degree: Fin<32>,
    public rounds: [Fin<32>; NUM_VARS_CONST]
) where true {
    let zero = claimed_sum - claimed_sum;
    let cfg0 = {| poly: poly, num_variables: num_variables, max_degree: max_degree,
                  round: rounds[0], challenge: zero |};
    let out0 = marginalize(cfg0);
    p1 <- out0.next_poly;

    let p1_at_0 = eval(p1, [0]);
    let p1_at_1 = eval(p1, [1]);
    verify(claimed_sum == p1_at_0[0] + p1_at_1[0]);

    //verify(sumcheck_round(out0.next_poly, num_variables, max_degree, rounds[1..NUM_VARS_CONST]));
}
