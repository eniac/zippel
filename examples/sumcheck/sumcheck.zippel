// Round 2 onward (prover): check g(0)+g(1) = previous g(r), then recurse on `next_poly` until `Poly<F,1>`.
// `challenge` is the verifier coin for this round; we draw the next one only before recursing.
fn sumcheck_round<F: Field, NUM_VARS_CONST: 4, V: 2..5, MAX_DEGREE_CONST: 2..3>(
    public orig_poly: Poly<F, NUM_VARS_CONST, MAX_DEGREE_CONST>,
    public curr_poly: Poly<F, V, MAX_DEGREE_CONST>,
    public challenges: [F; NUM_VARS_CONST - V],
    public prev_eval: F,
    public challenge: F,
    public curr_round: F
) -> Bool {
    let cfg = {| poly: curr_poly, max_degree: MAX_DEGREE_CONST, round: curr_round, challenge: challenge |};
    let out = marginalize(cfg);
    let pi = out.next_poly;

    evs <- out.evaluations;
    let round_ok = prev_eval == evs[0] + evs[1];

    let g = interpolate0d(evs, MAX_DEGREE_CONST);
    r_next <- challenge<F>;
    let next_prev_vec = eval(g, [r_next]);
    let next_prev = next_prev_vec[0];

    let next_challenges = challenges ++ [r_next];
    let tail_ok = sumcheck_round(orig_poly, pi, next_challenges, next_prev, r_next, curr_round + 1);
    round_ok && tail_ok
}

fn sumcheck_round<F: Field, NUM_VARS_CONST: 4, MAX_DEGREE_CONST: 3>(
    public orig_poly: Poly<F, NUM_VARS_CONST, MAX_DEGREE_CONST>,
    public curr_poly: Poly<F, 1, MAX_DEGREE_CONST>,
    public challenges: [F; NUM_VARS_CONST - 1],
    public prev_eval: F,
    public challenge: F,
    public curr_round: F
) -> Bool {
    let cfg = {| poly: curr_poly, max_degree: MAX_DEGREE_CONST, round: curr_round, challenge: challenge |};
    let out = marginalize(cfg);
    evs <- out.evaluations;
    let round_ok = prev_eval == evs[0] + evs[1];

    let g = interpolate0d(evs, MAX_DEGREE_CONST);
    r_final <- challenge<F>;
    let full_challenges = challenges ++ [r_final];
    let from_round_vec = eval(g, [r_final]);
    let from_round = from_round_vec[0];
    let from_orig = eval(orig_poly, full_challenges);

    round_ok && from_round == from_orig
}

// Round 1: first challenge r1 folds round-1 message; second challenge r2 feeds the first tail round.
proto sumcheck<F: Field, NUM_VARS_CONST: 4, MAX_DEGREE_CONST: 3>(
    public claimed_sum: F,
    public poly: Poly<F, NUM_VARS_CONST, MAX_DEGREE_CONST>
) where let zero = claimed_sum - claimed_sum;
        let cfg0 = {| poly: poly, max_degree: MAX_DEGREE_CONST, round: 0, challenge: zero |};
        let out0 = marginalize(cfg0);
        let evs0 = out0.evaluations;
        claimed_sum == evs0[0] + evs0[1] {
    let zero = claimed_sum - claimed_sum;
    let cfg0 = {| poly: poly, max_degree: MAX_DEGREE_CONST, round: 0, challenge: zero |};
    let out0 = marginalize(cfg0);
    evs0 <- out0.evaluations;
    let round1_ok = claimed_sum == evs0[0] + evs0[1];
    r1 <- challenge<F>;
    let g = interpolate0d(evs0, MAX_DEGREE_CONST);
    let prev_vec = eval(g, [r1]);
    let prev = prev_vec[0];
    verify(round1_ok && sumcheck_round(poly, out0.next_poly, [r1], prev, r1, 1))
}
