// Base case: final round (one variable remaining)
fn sumcheck_round<F: Field>(
    public claimed_sum: F,
    public current_poly: Mle<F, 1>,
    public round_claims: [F; 2]
) -> Bool {
    verify(claimed_sum == round_claims[0] + round_claims[1]);

    r <- challenge<F>;

    let zero = claimed_sum - claimed_sum;
    let one = zero + 1;
    let coeff_left = one - r;
    let g_line = (coeff_left * round_claims[0]) + (r * round_claims[1]);

    let r_point = [r];
    eval_vec <- eval(current_poly, r_point);
    let oracle_eval = eval_vec[0];

    g_line == oracle_eval
}

// Recursive case: V ≥ 2
fn sumcheck_round<F: Field, S: Size, V: 2..S>(
    public claimed_sum: F,
    public p: Poly<F, V, DEGREE>,
    public current_poly: Mle<F, V>,
    public round_claims: [F; 2*V]
) -> Bool {
    verify(claimed_sum == round_claims[0] + round_claims[1]);

    r <- challenge<F>;
    let next_claim = ((1-r) * round_claims[0]) + (r * round_claims[1]);

    let r_point = [r];
    let next_poly = p(r_point);

    sumcheck_round(next_claim, next_poly, round_claims[2..2*V])
}

fn inner_poly<F: Field, S: Size, NUM_VARS: 1..S>(a: Mle<F, NUM_VARS>, b: Mle<F, NUM_VARS>, c: Poly<F, NUM_VARS, 2>) \
   -> Poly<F, NUM_VARS, 6> {
   5*a*b + 10*c^3 - a*c
}

fn hypercube<F: Field, N> -> Vec<F, 2^N> {
}

fn sum_check_spec(a: Mle<F, NUM_VARS_CONST>, b: Mle<F, NUM_VARS_CONST>, c: Mle<F, NUM_VARS_CONST>) -> F {
   let p = inner_poly(a, b, c);
   let v = [p(i) for i in hypercube<NUM_VARS_CONST>()];
   reduce(+, v)
}

// Entry point: claimed sum, multilinear polynomial, and prover messages.
// Prove: \sum_{i=0}^n a_i * b_i = s
proto sumcheck<F: Field, S: Size, NUM_VARS_CONST, DEGREE>(
    public claimed_sum: F,
    public a: Mle<F, NUM_VARS_CONST>,
    public b: Mle<F, NUM_VARS_CONST>,
    public c: Mle<F, NUM_VARS_CONST>,
    public round_claims: [F; 2*NUM_VARS_CONST]
) where (sum_check_spec(inner_poly(a, b, c)) == claimed_sum) {
    verify(sumcheck_round(claimed_sum, inner_poly(a,b,c), round_claims));
}
