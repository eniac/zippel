// Round 2 onward (prover): check g(0)+g(1) = previous g(r), then recurse on `next_poly` until `Poly<F,1>`.
// `challenge` is the verifier coin for this round; we draw the next one only before recursing.
//
// orig_poly was removed: the final subclaim `eval(orig_poly, full_challenges)`
// is delegated to the prover (matches hyperplonk's SumCheck::verify which
// returns a subclaim and leaves the polynomial opening to the caller).
// With orig_poly gone from the protocol surface, the verifier no longer
// absorbs the full polynomial into the FS transcript at the start (which
// was the dominant O(2^NV) cost in verify) — making verify O(log N)
// instead of O(N).
fn sumcheck_round<F: Field, NUM_VARS_CONST: 10, V: 2..NUM_VARS_CONST, MAX_DEGREE_CONST: 10>(
    private curr_poly: Poly<F, V, MAX_DEGREE_CONST>,
    public points: [F; MAX_DEGREE_CONST + 1],
    public challenges: [F; NUM_VARS_CONST - V],
    public prev_eval: F,
    public challenge: F,
    public curr_round: Fin<NUM_VARS_CONST>
) -> Bool {
    let cfg = {| poly: curr_poly, num_variables: NUM_VARS_CONST, max_degree: MAX_DEGREE_CONST, round: curr_round, challenge: challenge |};
    let out = marginalize(cfg);
    let pi = out.next_poly;

    evs <- out.evaluations;
    verify(prev_eval == evs[0] + evs[1]);

    let g = interpolate(points, evs);
    r_next <- challenge<F>;
    let next_prev_vec = eval(g, [r_next]);
    let next_prev = next_prev_vec[0];

    let next_challenges = challenges ++ [r_next];
    sumcheck_round(pi, points, next_challenges, next_prev, r_next, curr_round + 1)
}

fn sumcheck_round<F: Field, NUM_VARS_CONST: 10, MAX_DEGREE_CONST: 10>(
    private curr_poly: Poly<F, 1, MAX_DEGREE_CONST>,
    public points: [F; MAX_DEGREE_CONST + 1],
    public challenges: [F; NUM_VARS_CONST - 1],
    public prev_eval: F,
    public challenge: F,
    public curr_round: Fin<NUM_VARS_CONST>
) -> Bool {
    let cfg = {| poly: curr_poly, num_variables: NUM_VARS_CONST, max_degree: MAX_DEGREE_CONST, round: curr_round, challenge: challenge |};
    let out = marginalize(cfg);
    evs <- out.evaluations;
    verify(prev_eval == evs[0] + evs[1]);

    let g = interpolate(points, evs);
    r_final <- challenge<F>;
    let _drop_g = g;
    let _drop_r = r_final;
    true
}

// Round 1: first challenge r1 folds round-1 message; second challenge r2 feeds the first tail round.
proto sumcheck<F: Field, NUM_VARS_CONST: 10, MAX_DEGREE_CONST: 10>(
    public claimed_sum: F,
    private poly: Poly<F, NUM_VARS_CONST, MAX_DEGREE_CONST>
) where let zero: F = 0;
        let cfg0 = {| poly: poly, num_variables: NUM_VARS_CONST, max_degree: MAX_DEGREE_CONST, round: 0, challenge: zero |};
        let out0 = marginalize(cfg0);
        let evs0 = out0.evaluations;
        claimed_sum == evs0[0] + evs0[1] {
    let zero: F = 0;
    let cfg0 = {| poly: poly, num_variables: NUM_VARS_CONST, max_degree: MAX_DEGREE_CONST, round: 0, challenge: zero |};
    let out0 = marginalize(cfg0);
    evs0 <- out0.evaluations;
    verify(claimed_sum == evs0[0] + evs0[1]);

    r1 <- challenge<F>;
    let points = [i for i in 0..MAX_DEGREE_CONST + 1];
    let g = interpolate(points, evs0);
    let prev_vec = eval(g, [r1]);
    let prev = prev_vec[0];
    verify(sumcheck_round(out0.next_poly, points, [r1], prev, r1, 1))
}
