// Protocol to prove that two committed values are equal.
// Assume Pedersen commitments: Commit(x, r) = g*x + h*r
// Prover knows secrets x, r1, r2. Verifier knows commitments C1, C2.
// Prover wants to prove that the value committed in C1 equals the value in C2.
proto prove_commitment_equality<G: Group, F: Scalar<G>>(
    private x: F,          // The secret value, same in both commitments
    private r1: F,         // Randomness for first commitment
    private r2: F,         // Randomness for second commitment
    public g: G,           // Base for value
    public h: G,           // Base for randomness
    public C1: G,          // Commitment C1 = g*x + h*r1
    public C2: G           // Commitment C2 = g*x + h*r2
) where C1 == g*x + h*r1 && C2 == g*x + h*r2 {
      // Prove that C1 - C2 commits to 0, using randomness r1 - r2
      // Let C_diff = C1 - C2 = g*x + h*r1 - (g*x + h*r2) = h*(r1 - r2)
      // We prove knowledge of (r1-r2) such that C_diff = h*(r1-r2)
      let r_diff = r1 - r2; // The secret randomness for the difference commitment C_diff

      let k = random<F>;    // Fresh randomness for the ZK proof itself
      C_diff <- C1 - C2;    // Make the difference public (usually computed by verifier)
      t <- h*k;             // Commitment to the randomness k

      c <- challenge<F>;
      z <- k + r_diff * c;  // Response revealing relation between k, r_diff, c

      // Verify knowledge of r_diff such that C_diff = h*r_diff
      // Check: h*z == t + C_diff*c
      // h*(k + r_diff*c) == h*k + (h*r_diff)*c
      // h*k + h*r_diff*c == h*k + C_diff*c  (This holds if C_diff = h*r_diff)
      verify(h*z == t + C_diff*c);
}
