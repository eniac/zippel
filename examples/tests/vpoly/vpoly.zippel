proto vpoly_product_check<F: Field, S: Size, N: S>(
    public a: Mle<F, N>,
    public b: Mle<F, N>
) where a == a {
    // Multiply two MLEs to create a virtual polynomial: Poly<F, 2, 2>
    let p = a * b;

    // Verifier challenges with random point (r1, r2)
    r1 <- challenge<F>;
    r2 <- challenge<F>;

    // Evaluate at the challenge point
    let lhs = eval(p, [r1, r2]);
    let rhs = eval(a, [r1, r2]) * eval(b, [r1, r2]);

    // Verify product consistency
    verify(lhs == rhs)
}
