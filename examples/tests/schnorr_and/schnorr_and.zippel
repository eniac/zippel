// Protocol to prove knowledge of x and y such that h1 = g*x and h2 = g*y
proto reuse_randomness<G: Group, F: Scalar<G>>(
    private x: F,
    private y: F,
    public g: G,
    public h1: G,
    public h2: G
) where h1 == g*x && h2 == g*y {
      let r = random<F>;  // Single random value
      u1 <- g*r;          // Commit related to x using r
      u2 <- g*r;          // Commit related to y using the *SAME* r
      c <- challenge<F>;
      z1 <- r + x*c;      // Response for x
      z2 <- r + y*c;      // Response for y
      verify(g*z1 == u1 + h1*c && g*z2 == u2 + h2*c)
}
